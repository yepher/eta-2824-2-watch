      half_space(nx = -0.559106, ny = 0.829096, nz = 0, d = 0mm - 4.2557mm),
      half_space(nx = -0.248945, ny = -0.968518, nz = 0, d = 0mm - 1.3311mm),
      half_space(nx = 0.379925, ny = 0.925017, nz = 0, d = 2.3342mm),
      box(x = 20mm, y = 20mm, z = 1mm),
    ),
    intersect(
      half_space(nx = -0.226699, ny = 0.973965, nz = 0, d = 0mm - 1.9648mm),
      half_space(nx = -0.379925, ny = -0.925017, nz = 0, d = 0mm - 2.3330mm),
      half_space(nx = 0.490970, ny = 0.871177, nz = 0, d = 3.1926mm),
      box(x = 20mm, y = 20mm, z = 1mm),
    ),
    intersect(
      half_space(nx = -0.022687, ny = 0.999743, nz = 0, d = 0mm - 0.5185mm),
      half_space(nx = -0.490970, ny = -0.871177, nz = 0, d = 0mm - 3.1916mm),
      half_space(nx = 0.602712, ny = 0.797959, nz = 0, d = 4.0669mm),
      box(x = 20mm, y = 20mm, z = 1mm),
    ),
    intersect(
      half_space(nx = 0.245797, ny = 0.969321, nz = 0, d = 1.4299mm),
      half_space(nx = -0.602712, ny = -0.797959, nz = 0, d = 0mm - 4.0660mm),
      half_space(nx = 0.701679, ny = 0.712493, nz = 0, d = 4.8523mm),
      box(x = 20mm, y = 20mm, z = 1mm),
    ),
    intersect(
      half_space(nx = 0.535680, ny = 0.844421, nz = 0, d = 3.5915mm),
      half_space(nx = -0.701679, ny = -0.712493, nz = 0, d = 0mm - 4.8518mm),
      half_space(nx = 0.773649, ny = 0.633614, nz = 0, d = 5.4326mm),
      box(x = 20mm, y = 20mm, z = 1mm),
    ),
    intersect(
      half_space(nx = 0.829096, ny = 0.559106, nz = 0, d = 5.8871mm),
      half_space(nx = 0.710729, ny = 0.703466, nz = 0, d = 4.9397mm),
      half_space(nx = -0.773649, ny = -0.633614, nz = 0, d = 0mm - 5.4322mm),
      box(x = 20mm, y = 20mm, z = 1mm),
    ),
  )

  let screw_hole = common.screw_clearance_hole(
    head_r = 0.46mm,
    head_h = 0.16mm,
    shank_r = 0.22mm,
    depth = datum.automatic_framework_thickness(),
  )
  let screw_holes = union(
    screw_hole
      |> at(
        dx = datum.automatic_framework_screw_a_x(),
        dy = datum.automatic_framework_screw_a_y(),
        dz = 0mm,
      ),
    screw_hole
      |> at(
        dx = datum.automatic_framework_screw_b_x(),
        dy = datum.automatic_framework_screw_b_y(),
        dz = 0mm,
      ),
  )

  -- The feet the module stands on. Dropped by accident when the blank was
  -- replaced with the measured outline, which left the framework floating at
  -- its own level with nothing carrying it down to the main plate.
  let foot = common.bridge_foot(
    r = datum.bridge_foot_radius(),
    h = datum.automatic_framework_seat_z() - datum.plate_train_face_z(),
    hole_r = 0.24mm,
  )
  let foot_dz = 0mm - datum.automatic_framework_thickness() / 2
    - (datum.automatic_framework_seat_z() - datum.plate_train_face_z()) / 2
  let feet = union(
    foot
      |> at(
        dx = datum.automatic_framework_screw_a_x(),
        dy = datum.automatic_framework_screw_a_y(),
        dz = foot_dz,
      ),
    foot
      |> at(
        dx = datum.automatic_framework_screw_b_x(),
        dy = datum.automatic_framework_screw_b_y(),
        dz = foot_dz,
      ),
  )

  -- The stack. `blank` is the measured plan and each band trims it in z; the
  -- foot and the post are round and central, so the outline never reaches them.
  let roof = intersect(
    blank,
    fw_band(
      r = 12mm,
      z0 = fw_roof_floor_z(),
      z1 = datum.automatic_framework_top_z(),
    ),
  )
  -- The rim goes deep, and the wheels are what stop it: 26 and 28 reach 7.55
  -- and 7.59 of the rotor axis, past step 6's 7.126, so the band is cut back
  -- where they pass under it. That is the project lead's own sentence about
  -- this part -- *trimmed so they don't interfere with the gears on the other
  -- side* -- and it is a cut rather than a bigger radius so the measured step
  -- survives everywhere the wheels do not reach.
  let wheel_reliefs = union(
    union(
      cylinder(r = 2.280mm + datum.running_clearance(), h = 4mm)
        |> at(dx = 0.9830mm, dy = 4.6560mm, dz = 0mm),
      cylinder(r = 2.280mm + datum.running_clearance(), h = 4mm)
        |> at(dx = 3.8910mm, dy = 3.5790mm, dz = 0mm),
    ),
    union(
      cylinder(r = 2.520mm + datum.running_clearance(), h = 4mm)
        |> at(dx = 4.3790mm, dy = 0.9000mm, dz = 0mm),
      cylinder(r = 2.940mm + datum.running_clearance(), h = 4mm)
        |> at(dx = 3.2190mm, dy = 0mm - 3.2930mm, dz = 0mm),
    ),
  )
  let rim = intersect(
    blank,
    cut(
      cut(
        fw_band(
          r = 12mm,
          z0 = datum.automatic_framework_seat_z(),
          z1 = datum.automatic_framework_top_z(),
        ),
        cylinder(r = 7.126mm, h = 4mm),
      ),
      wheel_reliefs,
    ),
  )
  let hub = fw_band(
    r = fw_foot_radius(),
    z0 = datum.automatic_seat_z(),
    z1 = datum.automatic_framework_top_z(),
  )
  -- 906 screws into THIS, not into the bearing: the bearing's inner race goes
  -- over the post and lands in the counterbore. Radius 1.250 is step 1 of the
  -- measured stack, and it is why the old 2.44 bore left no annulus for a
  -- central spacer -- there was never meant to be a 2.44 hole here.
  --
  -- The post rises from the *counterbore floor*, not from the plate top. Both
  -- races of the bearing occupy 3.70 to 4.60: the outer one drops into the
  -- recess and the inner one goes over the post, so they have to start at the
  -- same height. Written from the plate top instead, the post stood 4.05 to
  -- 4.26 -- wholly inside the recess the next line cuts -- and the built solid
  -- topped out at 4.05 with no post at all.
  let post = fw_band(
    r = datum.rotor_bearing_bore_radius(),
    z0 = datum.rotor_bearing_floor_z(),
    z1 = datum.rotor_bearing_floor_z() + datum.rotor_bearing_height()
      - datum.rotor_screw_head_depth(),
  )
  -- An annulus, not a disc. A disc of this radius reaches the axis, so it
  -- takes the post with it; what the bearing actually needs is the ring
  -- between the post and the seat.
  let counterbore = cut(
    fw_band(
      r = datum.rotor_bearing_seat_radius() + datum.running_clearance(),
      z0 = datum.rotor_bearing_floor_z(),
      z1 = datum.automatic_framework_top_z() + 0.4mm,
    ),
    fw_band(
      r = datum.rotor_bearing_bore_radius(),
      z0 = datum.rotor_bearing_floor_z() - 0.2mm,
      z1 = datum.automatic_framework_top_z() + 0.6mm,
    ),
  )
  -- The tapped hole 906 turns into. It runs the whole depth of the post and
  -- the hub under it: the screw's shank bottom lands on the automatic seat at
  -- 3.35, measured off its own placement, so a blind hole above that would
  -- leave the last of the thread standing in metal.
  let rotor_screw_tap = fw_band(
    r = datum.rotor_screw_thread_radius() + datum.running_clearance(),
    z0 = datum.automatic_seat_z() - 0.2mm,
    z1 = datum.rotor_bearing_floor_z() + datum.rotor_bearing_height()
      - datum.rotor_screw_head_depth() + 0.1mm,
  )

  cut(
    union(union(roof, rim), union(hub, post), feet),
    union(counterbore, rotor_screw_tap, openings, screw_holes),
  )
}




part eta_pos_30_automatic_lower_bridge_envelope() -> Solid<Exact> {
  -- DERIVED from its anchors, the same way as position 25 above. This part was
  -- guessed twice - once as a matchstick two discs wide, once as a fat blob -
  -- and the project lead could not find it in the render at all the first time.
  --
  -- A bridge is material around each pivot it carries, material around each
  -- screw, and webs between them. Here that is the three wheels at
  -- reduction_ring_z, an 1.15 boss at each, an 1.05 boss at the 905 screw, and
  -- 2.0 webs joining them in the order the chain runs. It comes out as the
  -- slender crescent the identification drawing shows, because that is what
  -- those anchors describe.
  --
  -- It stops short of the driving wheel, which runs a level lower and is
  -- carried by the framework instead.
  let blank = union(
    cylinder(r = 1.15mm, h = datum.automatic_bridge_thickness())
      |> at(dx = 4.7741mm, dy = 0mm - 0.9096mm, dz = 0mm),
    cylinder(r = 1.15mm, h = datum.automatic_bridge_thickness())
      |> at(dx = 5.4663mm, dy = 3.1721mm, dz = 0mm),
    cylinder(r = 1.15mm, h = datum.automatic_bridge_thickness())
      |> at(dx = 1.9345mm, dy = 5.7628mm, dz = 0mm),
    cylinder(r = 1.05mm, h = datum.automatic_bridge_thickness())
      |> at(
        dx = datum.automatic_bridge_screw_x(),
        dy = datum.automatic_bridge_screw_y(),
        dz = 0mm,
      ),
    box(x = 4.14mm, y = 2mm, z = datum.automatic_bridge_thickness())
      |> rotate(ax = 0, ay = 0, az = 1, angle = 80.375deg)
      |> at(dx = 5.1202mm, dy = 1.1313mm, dz = 0mm),
    box(x = 4.3801mm, y = 2mm, z = datum.automatic_bridge_thickness())
      |> rotate(ax = 0, ay = 0, az = 1, angle = 143.739deg)
      |> at(dx = 3.7004mm, dy = 4.4675mm, dz = 0mm),
    box(x = 2.1319mm, y = 2mm, z = datum.automatic_bridge_thickness())
      |> rotate(ax = 0, ay = 0, az = 1, angle = 101.76deg)
      |> at(dx = 1.7172mm, dy = 6.8064mm, dz = 0mm),
  )
  let bore = cylinder(r = 0.26mm, h = 0.6mm)
  let bores = union(
    bore |> at(dx = 4.7741mm, dy = 0mm - 0.9096mm, dz = 0mm),
    bore |> at(dx = 5.4663mm, dy = 3.1721mm, dz = 0mm),
    bore |> at(dx = 1.9345mm, dy = 5.7628mm, dz = 0mm),
  )
  let screw_hole = common.screw_clearance_hole(
    head_r = 0.48mm,
    head_h = 0.17mm,
    shank_r = 0.23mm,
    depth = datum.automatic_bridge_thickness(),
  )
    |> at(
      dx = datum.automatic_bridge_screw_x(),
      dy = datum.automatic_bridge_screw_y(),
      dz = 0mm,
    )

  cut(blank, union(bores, screw_hole))
}




-- The weight's outline: a segment of a disc, cut by one chord, with a round hub
-- boss standing above that chord. Every number is measured -- see
-- `datum.rotor_chord_drop` and its neighbours.
fn rotor_segment(r: Len, h: Len) -> Solid<Exact> {
  intersect(
    cylinder(r = r, h = h),
    half_space(nx = 0, ny = 1, nz = 0, d = 0mm - datum.rotor_chord_drop()),
  )
}

part eta_pos_31_1_rotor_weight_envelope() -> Solid<Exact> {
  -- MEASURED from page 6, blob 126. Replaces a spoked half-annulus with an 8.6
  -- bore and two straight arms, none of which the part has. It is a solid
  -- segment in three thicknesses: a heavy rim outside 9.589, a thin web in to
  -- 7.198, and the hub platform inside that carrying the bearing.
  --
  -- Built with its TOP FACE on local z = 0 and all material hanging below,
  -- because the weight is flush with the top of the movement and everything
  -- else about it is measured downward from there.
  let rim = cut(
    rotor_segment(r = datum.rotor_radius(), h = datum.rotor_rim_thickness())
      |> at(dx = 0mm, dy = 0mm, dz = 0mm - datum.rotor_rim_thickness() / 2),
    cylinder(r = datum.rotor_web_radius(), h = 4mm),
  )
  let web = cut(
    rotor_segment(r = datum.rotor_web_radius(), h = datum.rotor_web_thickness())
      |> at(dx = 0mm, dy = 0mm, dz = 0mm - datum.rotor_web_thickness() / 2),
    cylinder(r = datum.rotor_hub_platform_radius(), h = 4mm),
  )
  let platform = union(
    rotor_segment(r = datum.rotor_hub_platform_radius(), h = datum.rotor_hub_thickness()),
    cylinder(r = datum.rotor_hub_radius(), h = datum.rotor_hub_thickness()),
  )
    |> at(dx = 0mm, dy = 0mm, dz = 0mm - datum.rotor_hub_thickness() / 2)
  -- Written out both sides rather than with `mirror`, because the interference
  -- audit's own evaluator (tools/cadeval.py) does not implement mirror and the
  -- whole part drops out of the audit if this uses it.
  let scallops = union(
    cylinder(r = datum.rotor_scallop_radius(), h = 4mm)
      |> at(
        dx = datum.rotor_scallop_x(),
        dy = datum.rotor_scallop_y(),
        dz = 0mm,
      ),
    cylinder(r = datum.rotor_scallop_radius(), h = 4mm)
      |> at(
        dx = 0mm - datum.rotor_scallop_x(),
        dy = datum.rotor_scallop_y(),
        dz = 0mm,
      ),
  )
  let bore = cylinder(r = datum.rotor_bearing_seat_radius(), h = 4mm)

  cut(union(rim, web, platform), union(scallops, bore))
}

part eta_pos_31_2_ball_bearing_envelope() -> Solid<Exact> {
  -- The races. The bearing presses UP into the weight's hub bore, and because
  -- it is 0.75 tall against a 0.5 hub it stands proud BELOW the hub -- which is
  -- where `eta_pos_31_3_rotor_pinion`, bored on the same race, has to sit, since
  -- at 2.82 over the teeth the ring cannot pass through the bore.
  --
  -- The central bore is the THREAD 906 Var screws into, not a clearance hole:
  -- the exploded view drops that screw straight down the bearing's axis and it
  -- is what holds the weight on. It was 0.72, which the 0.28 shank rattled in.
  -- The bore is the INNER RACE, and it goes over position 25's post.
  --
  -- It was `rotor_screw_thread_radius` -- 0.28 -- on the reading that 906
  -- threads into the bearing itself. Corrected 2026-09-07: 906 threads into the
  -- post, the post is `rotor_bearing_bore_radius` = 1.250, and that number is
  -- measured (step 1 of `tools/framework_steps.py`). The old reading is what
  -- made the central spacer impossible to place, because a 2.44 hole through
  -- the framework left nothing for it to be.
  let races = common.bored_disk(
    r = datum.rotor_bearing_seat_radius(),
    h = datum.rotor_bearing_height(),
    bore_r = datum.rotor_bearing_bore_radius() + datum.running_clearance(),
  )
  let head_recess = cylinder(
    r = datum.rotor_screw_head_radius() + datum.static_clearance(),
    h = datum.rotor_screw_head_depth(),
  )
    |> at(
      dx = 0mm,
      dy = 0mm,
      dz = datum.rotor_bearing_height() / 2 - datum.rotor_screw_head_depth() / 2,
    )

  cut(races, head_recess)
}

part rotor_assembly() -> Assembly {
  together(
    eta_pos_31_1_rotor_weight_envelope()
      |> place(
        frame = frame(
          origin = point(x = 0mm, y = 0mm, z = datum.rotor_top_z()),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 174, g = 171, b = 164),
      ),
    eta_pos_31_2_ball_bearing_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = 0mm,
            y = 0mm,
            z = (datum.rotor_bearing_floor_z() + datum.rotor_bearing_top_z()) / 2,
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 103, g = 112, b = 123),
      ),
    eta_pos_31_3_rotor_pinion()
      |> place(
        frame = frame(
          origin = point(x = 0mm, y = 0mm, z = rotor_ring_z()),
          axis = Z,
          angle = 111.358deg,
        ),
        color = rgb(r = 150, g = 158, b = 168),
      ),
  )
}

part automatic_winding_assembly() -> Assembly {
  together(
    eta_pos_25_automatic_framework_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = 0mm,
            y = 0mm,
            z = datum.automatic_framework_seat_z()
              + datum.automatic_framework_thickness() / 2,
          ),
          axis = Z,
          angle = 0deg,
        ),
        -- Bright steel. It was rgb(180, 176, 168) against a main plate of
        -- rgb(190, 184, 168) -- a 0.2 plate in the same cream as the gilt plate
        -- 1.7 below it, which is why this part could not be SEEN in the viewer
        -- even when it was correctly placed. The real one is steel on gilt.
        color = rgb(r = 208, g = 212, b = 217),
      ),
    eta_pos_27_aux_reversing_wheel_envelope()
      |> place(
        frame = frame(
          origin = point(x = 0.9830mm, y = 4.6560mm, z = reduction_ring_z()),
          axis = Z,
          angle = 174.213deg,
        ),
        color = rgb(r = 148, g = 157, b = 167),
      ),
    eta_pos_28_reversing_wheel_envelope()
      |> place(
        frame = frame(
          origin = point(x = 3.8910mm, y = 3.5790mm, z = reduction_ring_z()),
          axis = Z,
          angle = 265.375deg,
        ),
        color = rgb(r = 148, g = 157, b = 167),
      ),
    eta_pos_29_reduction_wheel_envelope(pinion_phase = 355.5deg)
      |> place(
        frame = frame(
          origin = point(x = 4.3790mm, y = 0.9000mm, z = reduction_ring_z()),
          axis = Z,
          angle = 328.239deg,
        ),
        color = rgb(r = 204, g = 164, b = 61),
      ),
    eta_pos_26_driving_wheel_envelope(pinion_phase = 356.17deg)
      |> place(
        frame = frame(
          origin = point(x = 3.2190mm, y = 0mm - 3.2930mm, z = driving_ring_z()),
          axis = Z,
          angle = 8.478deg,
        ),
        color = rgb(r = 194, g = 153, b = 52),
      ),
    eta_pos_30_automatic_lower_bridge_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = 0mm,
            y = 0mm,
            z = datum.automatic_bridge_underside_z()
              + datum.automatic_bridge_thickness() / 2,
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 150, g = 154, b = 164),
      ),
    rotor_assembly(),
  )
}
