    collar_h = 0.1mm,
    shank_r = 0.22mm,
    shank_h = 0.62mm,
    slot_w = 0.2mm,
    slot_depth = 0.12mm,
  )
}

part eta_pos_903_ratchet_wheel_screw_envelope() -> Solid<Exact> {
  -- ETA explicitly specifies a left-hand thread; pitch and diameter remain unknown.
  common.slotted_cylindrical_screw(
    head_r = 0.62mm,
    head_h = 0.2mm,
    shank_r = 0.24mm,
    shank_h = 0.68mm,
    slot_w = 0.22mm,
    slot_depth = 0.12mm,
  )
}

