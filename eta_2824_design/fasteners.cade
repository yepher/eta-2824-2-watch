import "./components.cade" as common
import "./datums.cade" as datum

part eta_pos_900_countersunk_screw_envelope() -> Solid<Exact> {
  common.slotted_countersunk_screw(
    head_r = 0.42mm,
    head_h = 0.16mm,
    shank_r = 0.18mm,
    shank_h = 0.55mm,
    slot_w = 0.16mm,
    slot_depth = 0.1mm,
  )
}

part eta_pos_901_bridge_screw_envelope() -> Solid<Exact> {
  common.slotted_countersunk_screw(
    head_r = 0.48mm,
    head_h = 0.18mm,
    shank_r = 0.2mm,
    shank_h = 0.72mm,
    slot_w = 0.18mm,
    slot_depth = 0.11mm,
  )
}

part eta_pos_902_crown_wheel_screw_envelope() -> Solid<Exact> {
  common.slotted_collared_screw(
    head_r = 0.56mm,
    head_h = 0.2mm,
    collar_r = 0.34mm,
    collar_h = 0.1mm,
    shank_r = 0.22mm,
    shank_h = 0.62mm,
    slot_w = 0.2mm,
    slot_depth = 0.12mm,
  )
}

part eta_pos_903_ratchet_wheel_screw_envelope() -> Solid<Exact> {
  -- ETA explicitly specifies a left-hand thread; pitch and diameter remain unknown.
  common.slotted_cylindrical_screw(
    head_r = 0.62mm,
    head_h = 0.2mm,
    shank_r = 0.24mm,
    shank_h = 0.68mm,
    slot_w = 0.22mm,
    slot_depth = 0.12mm,
  )
}

part eta_pos_904_automatic_framework_screw_envelope() -> Solid<Exact> {
  common.slotted_countersunk_screw(
    head_r = 0.44mm,
    head_h = 0.16mm,
    shank_r = 0.18mm,
    shank_h = 0.62mm,
    slot_w = 0.16mm,
    slot_depth = 0.1mm,
  )
}

part eta_pos_905_automatic_bridge_screw_envelope() -> Solid<Exact> {
  common.slotted_countersunk_screw(
    head_r = 0.46mm,
    head_h = 0.17mm,
    shank_r = 0.19mm,
    shank_h = 0.64mm,
    slot_w = 0.17mm,
    slot_depth = 0.1mm,
  )
}

part eta_pos_906_rotor_screw_envelope() -> Solid<Exact> {
  common.slotted_collared_screw(
    head_r = 0.72mm,
    head_h = 0.22mm,
    collar_r = 0.44mm,
    collar_h = 0.12mm,
    shank_r = 0.28mm,
    shank_h = 0.78mm,
    slot_w = 0.24mm,
    slot_depth = 0.13mm,
  )
}

part eta_pos_907_minute_bridge_screw_envelope() -> Solid<Exact> {
  common.slotted_shouldered_screw(
    head_r = 0.45mm,
    head_h = 0.18mm,
    shoulder_r = 0.29mm,
    shoulder_h = 0.2mm,
    shank_r = 0.2mm,
    shank_h = 0.82mm,
    slot_w = 0.18mm,
    slot_depth = 0.11mm,
  )
}

-- Where a head finishes, measured from each screw's own origin. A screw is
-- placed at `surface - head_top()`, so its head lands flush on the part it
-- clamps and its shank reaches the tapped hole below.
fn head_top_900() -> Len {
  0.355mm
}

fn head_top_901() -> Len {
  0.45mm
}

fn head_top_902() -> Len {
  0.41mm
}

fn head_top_903() -> Len {
  0.44mm
}

fn head_top_904() -> Len {
  0.39mm
}

fn head_top_905() -> Len {
  0.405mm
}

fn head_top_906() -> Len {
  0.5mm
}

fn head_top_907() -> Len {
  0.5mm
}

-- Every screw in the movement, installed. One definition per screw class,
-- placed wherever that class is used, so a change to the class -- a thread
-- callout, a head profile, a driver slot -- propagates everywhere it is used.
--
-- Each is seated: the head finishes flush on the part it clamps and the shank
-- runs into a tapped hole. The axes come from `datums.cade`, which the bridge
-- feet and the plate's tapped holes read as well, so the three cannot drift.
--
-- Threads are deliberately not drawn: Cade states a thread as metadata rather
-- than geometry (GAPS.md, GAP-2026-09-05-01), and the crest cylinder is the
-- surface a machinist sees. Adding `thread = thread(...)` to these placements
-- is the whole change when the fine-detail phase arrives.
part fasteners_assembly() -> Assembly {
  together(
    eta_pos_901_bridge_screw_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = datum.train_bridge_screw_a_x(),
            y = datum.train_bridge_screw_a_y(),
            z = datum.train_bridge_top_z() - head_top_901(),
          ),
          axis = Z,
          angle = -24deg,
        ),
        color = rgb(r = 78, g = 86, b = 97),
      ),
    eta_pos_901_bridge_screw_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = datum.train_bridge_screw_b_x(),
            y = datum.train_bridge_screw_b_y(),
            z = datum.train_bridge_top_z() - head_top_901(),
          ),
          axis = Z,
          angle = 12deg,
        ),
        color = rgb(r = 78, g = 86, b = 97),
      ),
    eta_pos_901_bridge_screw_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = datum.barrel_bridge_screw_a_x(),
            y = datum.barrel_bridge_screw_a_y(),
            z = datum.barrel_bridge_top_z() - head_top_901(),
          ),
          axis = Z,
          angle = -41deg,
        ),
        color = rgb(r = 78, g = 86, b = 97),
      ),
    eta_pos_901_bridge_screw_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = datum.barrel_bridge_screw_b_x(),
            y = datum.barrel_bridge_screw_b_y(),
            z = datum.barrel_bridge_top_z() - head_top_901(),
          ),
          axis = Z,
          angle = 29deg,
        ),
        color = rgb(r = 78, g = 86, b = 97),
      ),
    eta_pos_901_bridge_screw_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = datum.balance_cock_screw_x(),
            y = datum.balance_cock_screw_y(),
            z = datum.train_bridge_underside_z() + 0.54mm - head_top_901(),
          ),
          axis = Z,
          angle = -11deg,
        ),
        color = rgb(r = 78, g = 86, b = 97),
      ),
    eta_pos_901_bridge_screw_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = datum.pallet_bridge_screw_x(),
            y = datum.pallet_bridge_screw_y(),
            z = datum.train_band_floor_z() + 0.34mm - head_top_901(),
          ),
          axis = Z,
          angle = -33deg,
        ),
        color = rgb(r = 78, g = 86, b = 97),
      ),
    eta_pos_902_crown_wheel_screw_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = datum.crown_wheel_centre_x(),
            y = datum.crown_wheel_centre_y(),
            z = datum.crown_wheel_top_z() - head_top_902(),
          ),
          axis = Z,
          angle = 17deg,
        ),
        color = rgb(r = 90, g = 99, b = 110),
      ),
    eta_pos_903_ratchet_wheel_screw_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = datum.barrel_centre_x(),
            y = datum.barrel_centre_y(),
            z = datum.ratchet_wheel_top_z() - head_top_903(),
          ),
          axis = Z,
          angle = -27deg,
        ),
        color = rgb(r = 82, g = 91, b = 103),
      ),
    eta_pos_906_rotor_screw_envelope()
      |> place(
        frame = frame(
          origin = point(x = 0mm, y = 0mm, z = datum.rotor_top_z() - head_top_906()),
          axis = Z,
          angle = 8deg,
        ),
        color = rgb(r = 105, g = 113, b = 124),
      ),
    eta_pos_904_automatic_framework_screw_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = datum.automatic_framework_screw_a_x(),
            y = datum.automatic_framework_screw_a_y(),
            z = datum.automatic_framework_top_z() - head_top_904(),
          ),
          axis = Z,
          angle = -14deg,
        ),
        color = rgb(r = 80, g = 88, b = 98),
      ),
    eta_pos_904_automatic_framework_screw_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = datum.automatic_framework_screw_b_x(),
            y = datum.automatic_framework_screw_b_y(),
            z = datum.automatic_framework_top_z() - head_top_904(),
          ),
          axis = Z,
          angle = 34deg,
        ),
        color = rgb(r = 80, g = 88, b = 98),
      ),
    eta_pos_905_automatic_bridge_screw_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = datum.automatic_bridge_screw_x(),
            y = datum.automatic_bridge_screw_y(),
            z = datum.automatic_bridge_top_z() - head_top_905(),
          ),
          axis = Z,
          angle = -22deg,
        ),
        color = rgb(r = 92, g = 101, b = 112),
      ),
    eta_pos_907_minute_bridge_screw_envelope()
      |> rotate(ax = 1, ay = 0, az = 0, angle = 180deg)
      |> place(
        frame = frame(
          origin = point(
            x = 3.9mm,
            y = -1.6mm,
            z = datum.minute_bridge_underside_z() + head_top_907(),
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 118, g = 126, b = 137),
      ),
    eta_pos_900_countersunk_screw_envelope()
      |> rotate(ax = 1, ay = 0, az = 0, angle = 180deg)
      |> place(
        frame = frame(
          origin = point(
            x = -8.6mm,
            y = -4.8mm,
            z = datum.maintaining_plate_floor_z() + head_top_900(),
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 74, g = 81, b = 91),
      ),
    eta_pos_900_countersunk_screw_envelope()
      |> rotate(ax = 1, ay = 0, az = 0, angle = 180deg)
      |> place(
        frame = frame(
          origin = point(
            x = -6.2mm,
            y = -6.9mm,
            z = datum.maintaining_plate_floor_z() + head_top_900(),
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 74, g = 81, b = 91),
      ),
  )
}

-- Kept as a named subset for previews of the winding train alone.
part verified_retaining_fasteners_assembly() -> Assembly {
  together(
    eta_pos_902_crown_wheel_screw_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = datum.crown_wheel_centre_x(),
            y = datum.crown_wheel_centre_y(),
            z = datum.crown_wheel_top_z() - head_top_902(),
          ),
          axis = Z,
          angle = 17deg,
        ),
        color = rgb(r = 90, g = 99, b = 110),
      ),
    eta_pos_903_ratchet_wheel_screw_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = datum.barrel_centre_x(),
            y = datum.barrel_centre_y(),
            z = datum.ratchet_wheel_top_z() - head_top_903(),
          ),
          axis = Z,
          angle = -27deg,
        ),
        color = rgb(r = 82, g = 91, b = 103),
      ),
    eta_pos_906_rotor_screw_envelope()
      |> place(
        frame = frame(
          origin = point(x = 0mm, y = 0mm, z = datum.rotor_top_z() - head_top_906()),
          axis = Z,
          angle = 8deg,
        ),
        color = rgb(r = 105, g = 113, b = 124),
      ),
  )
}
