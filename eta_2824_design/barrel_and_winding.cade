    ),
    intersect(
      half_space(nx = -0.280556, ny = -0.959838, nz = 0, d = 1.8106mm),
      half_space(nx = -0.027870, ny = -0.999612, nz = 0, d = 0.7470mm),
      half_space(nx = 0.064928, ny = 0.997890, nz = 0, d = 0mm - 0.8301mm),
