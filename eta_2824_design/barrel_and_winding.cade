import "./components.cade" as common
import "./going_train.cade" as train
import "./datums.cade" as datum

-- ETA positions 14 to 20: the barrel, its bridge and the winding train.
--
-- Rebuilt 2026-09-05 on measured geometry. The barrel measures 12.29mm over
-- the great wheel and sits at a measured centre, and the winding train is
-- module 0.23 rather than the 0.100 this file used to assume -- the crown
-- wheel is the one wheel on the materials page whose teeth resolve, and it
-- counts 26 on 6.29mm. See eta_2824-2_info.md.
part eta_pos_14_barrel_envelope() -> Solid<Exact> {
  -- The great wheel: 74 teeth on module 0.16078, pitch radius 5.9489mm, driving
  -- the second wheel's 12-leaf pinion at the measured 6.9136mm centre
  -- distance. The drum is turned below the tooth root so the second wheel's
  -- pinion can reach the teeth without fouling the drum under them.
  union(
    common.involute_disk(
      root_r = 5.7479mm,
      bore_r = 0.45mm,
      flank_nx = 0.30925,
      flank_ny = 0.95098,
      flank_d = 1.94804mm,
      inner_x = 5.1737mm,
      tip_r = 6.1104mm,
      h = datum.train_wheel_thickness(),
      teeth = 74,
    )
      |> at(
        dx = 0mm,
        dy = 0mm,
        dz = datum.barrel_wheel_z()
          - (datum.barrel_floor_z() + datum.barrel_ceiling_z()) / 2,
      ),
    common.bored_disk(
      r = datum.barrel_radius(),
      h = datum.barrel_height() - 0.28mm,
      bore_r = 0.45mm,
    ),
    common.bored_disk(r = 1mm, h = datum.barrel_height(), bore_r = 0.45mm),
  )
}

part eta_pos_15_stop_lever_envelope() -> Solid<Exact> {
  box(x = 4mm, y = 0.55mm, z = 0.18mm)
}

-- How deep the ratchet wheel sinks into the barrel bridge's top face. Held to
-- less than the bridge's own thickness so the counterbore keeps a floor.
--
-- OPEN, and it exposes an axial conflict this does not resolve. The bridge runs
-- 2.820 to 3.220 and the ratchet wheel is 0.53 thick with its top at the 3.35
-- base movement height, so the wheel wants 2.820 to 3.350 -- the same space as
-- the bridge. Sitting the wheel ON the bridge needs 3.220 + 0.53 = 3.750, which
-- is over the 3.35 ceiling. The barrel height, the bridge thickness or the
-- ratchet's own thickness has to give; none of the three is measured. Recorded
-- rather than absorbed.
fn ratchet_countersink_depth() -> Len {
  0.15mm
}

part eta_pos_16_barrel_bridge_envelope() -> Solid<Exact> {
  -- Carries the barrel arbor and stands on two feet that reach the plate.
  -- It is relieved by the parts that pass through it rather than trimmed by
  -- hand: the crown wheel stands in an opening through the bridge and the
  -- ratchet wheel is countersunk into its top face, both cut with the wheels'
  -- own clearance cylinders, so the relief follows if either wheel moves.
  -- Local coordinates are relative to the placement at (6.3586mm, 3.6287mm).
  -- MEASURED and GENERATED: `tools/page6_outline.py 62 1828.1 3460.7 -3.5246
  -- 2.0763 46 1 datum.barrel_bridge_thickness()`. Page 6 blob 62, the kidney
  -- carrying the barrel arbor and the click work, at 30.938 px/mm.
  --
  -- It was a stick figure: three discs and four rotated boxes, 10.18 x 10.25
  -- against a drawn 17.32 x 17.84 -- about a THIRD of the area. That is why the
  -- render showed the barrel and the whole going train lying open where the real
  -- movement shows bridge. See ERRORS.md E12.
  --
  -- Anchored on the BARREL ARBOR HOLE, the 1.16 round opening the drawing puts at
  -- (1828.1, 3460.7) px, mapped to this part's local (-3.5246, 2.0763) which is
  -- the barrel centre. Mirrored and swept: at 46 degrees it covers 73.3% of the
  -- barrel and the going train, takes 0.0% of the balance bridge, and puts the
  -- crown wheel's centre on the bridge where its relief is cut. The band is soft
  -- -- 32 to 46 all score alike -- so this rotation is good to about 10 degrees
  -- and no better. The two screw datums do NOT fit the drawing's holes (they are
  -- 161 degrees apart on the drawing, 90 in the datums), so they are estimates
  -- that still need measuring, exactly as the framework's screw a did.
  let blank = union(
    intersect(
      half_space(nx = 0.607225, ny = 0.794530, nz = 0, d = 0mm - 0.6751mm),
      half_space(nx = -0.323213, ny = 0.946326, nz = 0, d = 10.3159mm),
