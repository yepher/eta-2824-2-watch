    ),
    intersect(
      half_space(nx = -0.064928, ny = -0.997890, nz = 0, d = 0.8315mm),
      half_space(nx = 0.160866, ny = -0.986976, nz = 0, d = 0.3058mm),
      half_space(nx = 0.036563, ny = 0.999331, nz = 0, d = 0mm - 0.7000mm),
      box(x = 33mm, y = 33mm, z = datum.barrel_bridge_thickness()),
    ),
    intersect(
      half_space(nx = -0.036563, ny = -0.999331, nz = 0, d = 0.7013mm),
      half_space(nx = 0.159544, ny = -0.987191, nz = 0, d = 0.3085mm),
      half_space(nx = 0.014576, ny = 0.999894, nz = 0, d = 0mm - 0.5989mm),
      box(x = 33mm, y = 33mm, z = datum.barrel_bridge_thickness()),
    ),
    intersect(
      half_space(nx = -0.166864, ny = -0.985980, nz = 0, d = 1.2994mm),
      half_space(nx = -0.014576, ny = -0.999894, nz = 0, d = 0.6000mm),
      half_space(nx = 0.029893, ny = 0.999553, nz = 0, d = 0mm - 0.6243mm),
      box(x = 33mm, y = 33mm, z = datum.barrel_bridge_thickness()),
    ),
    intersect(
      half_space(nx = -0.115679, ny = -0.993287, nz = 0, d = 0.7638mm),
      half_space(nx = 0.001764, ny = -0.999998, nz = 0, d = 0.6512mm),
      half_space(nx = 0.076300, ny = 0.997085, nz = 0, d = 0mm - 0.7000mm),
      box(x = 33mm, y = 33mm, z = datum.barrel_bridge_thickness()),
    ),
    intersect(
      half_space(nx = -0.076300, ny = -0.997085, nz = 0, d = 0.7005mm),
      half_space(nx = 0.001567, ny = -0.999999, nz = 0, d = 0.6514mm),
      half_space(nx = 0.056712, ny = 0.998391, nz = 0, d = 0mm - 0.6683mm),
      box(x = 33mm, y = 33mm, z = datum.barrel_bridge_thickness()),
    ),
    intersect(
      half_space(nx = -0.079089, ny = -0.996868, nz = 0, d = 0.8681mm),
      half_space(nx = -0.029893, ny = -0.999553, nz = 0, d = 0.6249mm),
      half_space(nx = 0.034462, ny = 0.999406, nz = 0, d = 0mm - 0.6321mm),
      box(x = 33mm, y = 33mm, z = datum.barrel_bridge_thickness()),
    ),
    intersect(
      half_space(nx = 0.783844, ny = -0.620957, nz = 0, d = 0.4415mm),
      half_space(nx = -0.770906, ny = 0.636949, nz = 0, d = 0mm - 0.3574mm),
      half_space(nx = -0.784852, ny = 0.619683, nz = 0, d = 0mm - 0.4404mm),
      box(x = 33mm, y = 33mm, z = datum.barrel_bridge_thickness()),
    ),
    intersect(
      half_space(nx = -0.188588, ny = -0.982056, nz = 0, d = 0.7387mm),
      half_space(nx = 0.784852, ny = -0.619683, nz = 0, d = 0.4434mm),
      half_space(nx = -0.742061, ny = 0.670332, nz = 0, d = 0mm - 0.1918mm),
      box(x = 33mm, y = 33mm, z = datum.barrel_bridge_thickness()),
    ),
    intersect(
      half_space(nx = -0.056712, ny = -0.998391, nz = 0, d = 0.7029mm),
      half_space(nx = 0.742061, ny = -0.670332, nz = 0, d = 0.2050mm),
      half_space(nx = -0.597864, ny = 0.801598, nz = 0, d = 0.5390mm),
      box(x = 33mm, y = 33mm, z = datum.barrel_bridge_thickness()),
    ),
    intersect(
      half_space(nx = -0.034462, ny = -0.999406, nz = 0, d = 0.6657mm),
      half_space(nx = 0.597864, ny = -0.801598, nz = 0, d = 0mm - 0.5078mm),
      half_space(nx = -0.362659, ny = 0.931922, nz = 0, d = 1.5072mm),
      box(x = 33mm, y = 33mm, z = datum.barrel_bridge_thickness()),
    ),
    intersect(
      half_space(nx = 0.026776, ny = -0.999641, nz = 0, d = 0.3380mm),
      half_space(nx = 0.362659, ny = -0.931922, nz = 0, d = 0mm - 1.4918mm),
      half_space(nx = -0.350618, ny = 0.936519, nz = 0, d = 1.5378mm),
      box(x = 33mm, y = 33mm, z = datum.barrel_bridge_thickness()),
    ),
    intersect(
      half_space(nx = 0.070354, ny = -0.997522, nz = 0, d = 0.0888mm),
      half_space(nx = 0.350618, ny = -0.936519, nz = 0, d = 0mm - 1.5358mm),
      half_space(nx = -0.340798, ny = 0.940137, nz = 0, d = 1.5730mm),
      box(x = 33mm, y = 33mm, z = datum.barrel_bridge_thickness()),
    ),
    intersect(
      half_space(nx = 0.233525, ny = -0.972351, nz = 0, d = 0mm - 0.9084mm),
      half_space(nx = 0.340798, ny = -0.940137, nz = 0, d = 0mm - 1.5717mm),
      half_space(nx = -0.337125, ny = 0.941460, nz = 0, d = 1.5856mm),
      box(x = 33mm, y = 33mm, z = datum.barrel_bridge_thickness()),
    ),
    intersect(
      half_space(nx = 0.296741, ny = -0.954958, nz = 0, d = 0mm - 1.3206mm),
      half_space(nx = 0.337125, ny = -0.941460, nz = 0, d = 0mm - 1.5851mm),
      half_space(nx = -0.335751, ny = 0.941951, nz = 0, d = 1.5903mm),
      box(x = 33mm, y = 33mm, z = datum.barrel_bridge_thickness()),
    ),
    intersect(
      half_space(nx = 0.315935, ny = -0.948781, nz = 0, d = 0mm - 1.4531mm),
      half_space(nx = 0.335751, ny = -0.941951, nz = 0, d = 0mm - 1.5901mm),
      half_space(nx = -0.335094, ny = 0.942185, nz = 0, d = 1.5926mm),
      box(x = 33mm, y = 33mm, z = datum.barrel_bridge_thickness()),
    ),
  )





  let feet = union(
    common.bridge_foot(
      r = datum.bridge_foot_radius(),
      h = datum.barrel_bridge_underside_z() - datum.plate_train_face_z(),
      hole_r = 0.24mm,
    )
      |> at(
        dx = 0mm - 2.2186mm,
        dy = 0mm - 4.8287mm,
        dz = 0mm - datum.barrel_bridge_thickness() / 2
          - (datum.barrel_bridge_underside_z() - datum.plate_train_face_z()) / 2,
      ),
    common.bridge_foot(
      r = datum.bridge_foot_radius(),
      h = datum.barrel_bridge_underside_z() - datum.plate_train_face_z(),
      hole_r = 0.24mm,
    )
      |> at(
        dx = 3.3014mm,
        dy = 3.3913mm,
        dz = 0mm - datum.barrel_bridge_thickness() / 2
          - (datum.barrel_bridge_underside_z() - datum.plate_train_face_z()) / 2,
      ),
  )
  let clearances = union(
    cylinder(r = 0.5mm, h = datum.barrel_bridge_thickness() + 0.4mm)
      |> at(dx = 0mm - 3.5246mm, dy = 2.0763mm, dz = 0mm),
    -- the crown wheel stands through the bridge
    cylinder(
      r = datum.crown_wheel_tip_radius() + datum.running_clearance(),
      h = datum.barrel_bridge_thickness() + 0.4mm,
    )
      |> at(
        dx = datum.crown_wheel_centre_x() - 6.3586mm,
        dy = datum.crown_wheel_centre_y() - 3.6287mm,
        dz = 0mm,
      ),
    -- the automatic module's driving pinion drops through here to the ratchet
    cylinder(r = 0.9mm, h = datum.barrel_bridge_thickness() + 0.4mm)
      |> at(dx = 0mm - 0.8175mm - 6.3586mm, dy = 3.5109mm - 3.6287mm, dz = 0mm),
    -- and the ratchet wheel is countersunk into its top face. A COUNTERBORE,
    -- floored -- it used to be a 0.6 cylinder placed from the ratchet's own seat,
    -- which put it at local -0.210 to +0.390 through a plate spanning -0.200 to
    -- +0.200. It cut a 3.78 radius hole clean through the bridge. That did not
    -- show while the blank was a stick figure barely wider than the hole; the
    -- moment the blank became the measured 17.3 x 17.8 outline it tore the plate
    -- into six pieces, which is the "shards" in the viewer.
    cylinder(
      r = datum.ratchet_wheel_tip_radius() + datum.running_clearance(),
      h = datum.barrel_bridge_thickness(),
    )
      |> at(
        dx = 0mm - 3.5246mm,
        dy = 2.0763mm,
        dz = datum.barrel_bridge_thickness() / 2
          + datum.barrel_bridge_thickness() / 2
          - ratchet_countersink_depth(),
      ),
    common.screw_clearance_hole(
      head_r = 0.5mm,
      head_h = 0.18mm,
      shank_r = 0.24mm,
      depth = datum.barrel_bridge_thickness(),
    )
      |> at(dx = 0mm - 2.2186mm, dy = 0mm - 4.8287mm, dz = 0mm),
    common.screw_clearance_hole(
      head_r = 0.5mm,
      head_h = 0.18mm,
      shank_r = 0.24mm,
      depth = datum.barrel_bridge_thickness(),
    )
      |> at(dx = 3.3014mm, dy = 3.3913mm, dz = 0mm),
  )
  -- Two bridges cannot share a volume. Rather than trim this outline by hand
  -- and have it drift, the barrel bridge is relieved by the train bridge's
  -- own solid, placed in this bridge's frame. Move either and the relief
  -- follows.
  let train_bridge_relief = train.eta_pos_13_train_bridge_envelope()
    |> at(
      dx = 0mm - 8.6406mm,
      dy = 0mm - 2.7604mm,
      dz = (datum.train_bridge_underside_z() + datum.train_bridge_top_z()) / 2
        - (datum.barrel_bridge_underside_z() + datum.barrel_bridge_top_z()) / 2,
    )

  cut(union(blank, feet), union(clearances, train_bridge_relief))
}

-- The barrel arbor's upper bearing is a plain hole in the bridge, not a jewel.
-- Nothing in the technical communication shows a jewel there, and a barrel
-- arbor turns once every six hours under high torque, which is the classic case
-- for a plain brass bearing rather than a jewelled one. The plate's LOWER
-- barrel bearing is jewelled and is evidenced -- it is one of the coloured
-- jewels measured off the plate view -- and it stays.
--
-- Modelling one here had put a 0.14mm bore around a 0.34mm arbor with the
-- ratchet screw through it as well, which is three bodies in one hole.

part eta_pos_17_click_envelope() -> Solid<Exact> {
  -- Pivots on a post in the barrel bridge; its beak drops between the ratchet
  -- wheel's teeth. Modelled with the pivot at the origin and the beak along +X.
  let body = union(
    cylinder(r = 0.42mm, h = 0.2mm),
    box(x = 0.9mm, y = 0.4mm, z = 0.2mm) |> at(dx = 0.45mm, dy = 0mm, dz = 0mm),
    cylinder(r = 0.2mm, h = 0.2mm) |> at(dx = 0.9mm, dy = 0mm, dz = 0mm),
  )

  cut(body, cylinder(r = 0.17mm, h = 0.4mm))
}

part eta_pos_18_click_spring_envelope() -> Solid<Exact> {
  -- A blade anchored to the barrel bridge, bearing on the click's tail.
  union(
    box(x = 1.5mm, y = 0.18mm, z = 0.14mm),
    box(x = 0.6mm, y = 0.18mm, z = 0.14mm)
      |> at(dx = 0.9mm, dy = 0.24mm, dz = 0mm)
      |> rotate(ax = 0, ay = 0, az = 1, angle = 28deg),
  )
}

part eta_pos_19_crown_wheel_envelope(bevel_phase: Angle) -> Solid<Exact> {
  -- 26 teeth on module 0.2298 -- twice the ratchet wheel's -- engaging EVERY
  -- OTHER tooth of the 63 on the ratchet. Pitch radius 2.9874, meshing at a
  -- 6.6068 centre distance. See `datum.winding_module` and ERRORS.md E9.
  --
  -- The teeth are slender because they have to enter a ratchet space half
  -- their own pitch: thinned to 0.166 at the pitch circle against the
  -- ratchet's 0.1805 space, they come to a point at 3.1775. That is an outside
  -- diameter of 6.355 against 6.29-6.41 measured off page 6 -- a number
  -- nothing here was fitted to.
  --
  -- One 0.82mm disc does both jobs. Its upper part is coplanar with the
  -- ratchet wheel it drives; the band of teeth standing down from its
  -- underside is the 90-degree face-gear interface to the stem's winding
  -- pinion, which reaches up through the plate to meet it.
  let wheel = common.involute_disk(
    root_r = 2.70015mm,
    bore_r = 0.44mm,
    flank_nx = 0.32495,
    flank_ny = 0.94573,
    flank_d = 1.02482mm,
    inner_x = 2.43013mm,
    tip_r = datum.crown_wheel_tip_radius(),
    h = datum.crown_wheel_thickness(),
    teeth = 26,
  )
  let underside_tooth = box(
    x = 0.28mm,
    y = 0.168mm,
    z = datum.crown_wheel_bevel_depth(),
  )
    |> rotate(ax = 0, ay = 1, az = 0, angle = 0deg - 26deg)
    |> at(
      dx = datum.crown_wheel_pitch_radius(),
      dy = 0mm,
      dz = 0mm - datum.crown_wheel_thickness() / 2
        - datum.crown_wheel_bevel_depth() / 2
        + 0.03mm,
    )
    |> polar(n = 26, axis = Z)
    |> rotate(ax = 0, ay = 0, az = 1, angle = bevel_phase)
  -- The crown-wheel screw's head finishes flush in a counterbore.
  let head_recess = cylinder(r = 0.6mm, h = 0.24mm)
    |> at(dx = 0mm, dy = 0mm, dz = datum.crown_wheel_thickness() / 2 - 0.11mm)

  cut(union(wheel, underside_tooth), head_recess)
}

part eta_pos_20_ratchet_wheel_envelope() -> Solid<Exact> {
  -- 63 teeth on module 0.1149, pitch radius 3.61935, over a measured 7.40-7.54
  -- outside diameter and 0.53 thick. Rides on the barrel arbor, held by the
  -- left-hand-threaded ratchet screw, position 903.
  --
  -- This one toothing does three jobs. The click holds it. The automatic
  -- module's driving pinion meshes it normally. And the crown wheel engages it
  -- TWO TEETH AT A TIME, on twice this module -- which is why the crown wheel
  -- carries 26 teeth against these 63 and still turns the barrel arbor.
  common.involute_spoked_wheel(
    root_r = 3.47572mm,
    rim_width = 0.36mm,
    hub_r = 0.78mm,
    bore_r = 0.36mm,
    spoke_width = 0.3mm,
    flank_nx = 0.30262,
    flank_ny = 0.95311,
    flank_d = 1.17143mm,
    inner_x = 3.12815mm,
    tip_r = 3.73425mm,
    h = datum.ratchet_wheel_thickness(),
    teeth = 63,
    spokes = 5,
  )
    |> cut(
      cylinder(r = 0.66mm, h = 0.26mm)
        |> at(dx = 0mm, dy = 0mm, dz = datum.ratchet_wheel_thickness() / 2 - 0.12mm),
    )
}

-- The crown wheel core: the post the crown wheel turns on. It seats in the
-- MAIN PLATE, not the bridge, because the bridge is open around the crown
-- wheel to let the wheel reach down to the winding pinion.
part crown_wheel_arbor() -> Solid<Exact> {
  -- Stops below the screw's COLLAR, not just below its head. Position 902 is a
  -- collared screw: an 0.34 collar sits in the crown wheel's 0.44 bore and only
  -- the 0.22 shank enters the arbor. An arbor rising to the head's counterbore
  -- floor puts its 0.26 bore around that collar, and no wall thin enough to
  -- clear it would be a wall. So the arbor stops at the collar's underside,
  -- 0.30 below the wheel's top face, leaving the collar in the wheel where it
  -- belongs. That is asymmetric -- a centred cylinder shortened by 0.30 only
  -- drops its top by 0.15 -- so the placement moves with the height. Bored 0.26
  -- for the 0.22 shank.
  cut(
    cylinder(
      r = 0.4mm,
      h = datum.crown_wheel_top_z() - datum.plate_train_face_z() - 0.3mm,
    ),
    cylinder(
      r = 0.26mm,
      h = datum.crown_wheel_top_z() - datum.plate_train_face_z() + 0.4mm,
    ),
  )
}

-- The click's pivot post, standing on the barrel bridge.
part click_post() -> Solid<Exact> {
  cylinder(r = 0.15mm, h = 0.42mm)
}

part barrel_arbor_upper_pivot() -> Solid<Exact> {
  -- Stepped, because a bearing takes a PIVOT and not the arbor's body: the thin
  -- end runs in the bridge and the shoulder stops on its underside. Bored from
  -- the top for the ratchet screw, which stops well short of the pivot.
  let pivot = cylinder(r = 0.13mm, h = 0.42mm)
    |> at(dx = 0mm, dy = 0mm, dz = 0mm - 0.34mm)
  let body = cylinder(r = 0.34mm, h = 0.68mm)
    |> at(dx = 0mm, dy = 0mm, dz = 0.21mm)

  cut(union(pivot, body), cylinder(r = 0.28mm, h = 0.62mm)
    |> at(dx = 0mm, dy = 0mm, dz = 0.34mm))
}

