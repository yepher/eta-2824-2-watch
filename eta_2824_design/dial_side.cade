          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 207, g = 166, b = 59),
      ),
    eta_pos_35_date_corrector_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = 0.64mm,
            y = 7.28mm,
            z = datum.calendar_band_floor_z() + 0.1mm,
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 144, g = 153, b = 163),
