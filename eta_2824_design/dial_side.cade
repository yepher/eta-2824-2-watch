          ),
          axis = Z,
          angle = 285.976deg,
        ),
        color = rgb(r = 150, g = 158, b = 168),
      ),
    eta_pos_34_1_minute_train_idler()
      |> place(
        frame = frame(
          origin = point(
            x = 3.4221mm,
            y = 2.9156mm,
            z = datum.calendar_band_floor_z() + 0.1mm,
          ),
          axis = Z,
          angle = 110.476deg,
        ),
        color = rgb(r = 199, g = 160, b = 55),
      ),
    eta_pos_34_minute_wheel_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = 2.35mm,
