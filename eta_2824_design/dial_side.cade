            z = datum.calendar_band_floor_z() + 0.12mm,
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 199, g = 158, b = 50),
      ),
    eta_pos_39_minute_train_bridge_envelope()
      |> place(
        frame = frame(
