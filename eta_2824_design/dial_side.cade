          axis = Z,
          angle = 200.099deg,
        ),
        color = rgb(r = 133, g = 143, b = 154),
      ),
    eta_pos_12_1_minute_train_driving_pinion()
      |> place(
        frame = frame(
          origin = point(
            x = datum.second_wheel_x(),
            y = datum.second_wheel_y(),
            z = datum.calendar_band_floor_z() + 0.1mm,
          ),
          axis = Z,
          angle = 282.867deg,
        ),
        color = rgb(r = 150, g = 158, b = 168),
      ),
    eta_pos_34_1_minute_train_idler()
      |> place(
        frame = frame(
          origin = point(
            x = 0mm - 3.496mm,
            y = 3.4223mm,
            z = datum.calendar_band_floor_z() + 0.1mm,
