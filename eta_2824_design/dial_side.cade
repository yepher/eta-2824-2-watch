import "./components.cade" as common
import "./datums.cade" as datum

-- The minute train. The cannon pinion is not on the going train's arbor -- the
-- centre carries the SECONDS wheel -- so the minute hand is driven indirectly:
-- the second wheel, which turns once an hour, reaches through the plate to a
-- pinion on the dial side, an idler carries the drive round the hour wheel, and
-- the minute wheel turns the cannon pinion.
--
--   second dial pinion 12 -> idler 40 -> minute wheel 36 -> cannon pinion 12
--
-- An idler changes no ratio, and 12 into 12 is 1:1, so the cannon pinion turns
-- once an hour exactly as the second wheel does.
part eta_pos_12_1_minute_train_driving_pinion() -> Solid<Exact> {
  common.toothed_disk(
    root_r = 0.475mm,
    tooth_depth = 0.225mm,
    tooth_width = 0.14mm,
    h = 0.24mm,
    bore_r = 0.13mm,
    teeth = 12,
  )
}

part eta_pos_34_1_minute_train_idler() -> Solid<Exact> {
  common.spoked_wheel(
    root_r = 1.875mm,
    rim_width = 0.24mm,
    tooth_depth = 0.225mm,
    tooth_width = 0.14mm,
    hub_r = 0.44mm,
    bore_r = 0.2mm,
    spoke_width = 0.16mm,
    h = 0.22mm,
    teeth = 40,
    spokes = 5,
  )
}

part eta_pos_32_setting_wheel_envelope() -> Solid<Exact> {
  -- Expert estimate: 24 teeth.
  common.toothed_disk(
    root_r = 0.75mm,
    tooth_depth = 0.12mm,
    tooth_width = 0.18mm,
    h = 0.25mm,
    bore_r = 0.2mm,
    teeth = 24,
  )
}

-- expert_estimate: the cannon pinion reaches from the calendar band down
-- through the dial to the minute-hand seat and no further. ETA gives the seat
-- itself: 0.900 +0.006/-0.004mm, so r = 0.45mm.
fn cannon_pinion_length() -> Len {
  1.3mm
}

fn cannon_pinion_seat_radius() -> Len {
  0.45mm
}

part eta_pos_33_cannon_pinion_envelope() -> Solid<Exact> {
  -- H2 0.90mm hand fitting with an estimated 12-tooth driving pinion.
  union(
    common.toothed_disk(
      root_r = 0.45mm,
      tooth_depth = 0.08mm,
      tooth_width = 0.14mm,
      h = 0.22mm,
      bore_r = 0.18mm,
      teeth = 12,
    ),
    cylinder(r = cannon_pinion_seat_radius(), h = cannon_pinion_length())
      |> at(dx = 0mm, dy = 0mm, dz = 0.11mm - cannon_pinion_length() / 2),
  )
}

part eta_pos_34_minute_wheel_envelope() -> Solid<Exact> {
  -- Ratio-constrained estimate: 36-tooth wheel and 10-leaf hour-driving pinion.
  union(
    common.spoked_wheel(
      root_r = 1.86mm,
      rim_width = 0.22mm,
      tooth_depth = 0.14mm,
      tooth_width = 0.16mm,
      hub_r = 0.44mm,
      bore_r = 0.2mm,
      spoke_width = 0.14mm,
      h = 0.25mm,
      teeth = 36,
      spokes = 5,
    ),
    common.toothed_disk(
      root_r = 0.38mm,
      tooth_depth = 0.07mm,
      tooth_width = 0.14mm,
      h = 0.34mm,
      bore_r = 0.2mm,
      teeth = 10,
    )
      |> at(dx = 0mm, dy = 0mm, dz = 0.15mm),
  )
}

part eta_pos_35_date_corrector_envelope() -> Solid<Exact> {
  common.toothed_disk(
    root_r = 1.08mm,
    tooth_depth = 0.12mm,
    tooth_width = 0.18mm,
    h = 0.22mm,
    bore_r = 0.18mm,
    teeth = 18,
  )
}

part eta_pos_36_date_indicator_envelope() -> Solid<Exact> {
  -- ETA drawing-supported: 23.30mm outside diameter and 31 internal teeth.
  common.internal_toothed_ring(
    outer_r = 11.65mm,
    root_r = 8.71mm,
    tooth_depth = 0.3mm,
    tooth_width = 0.32mm,
    h = 0.3mm,
    teeth = 31,
  )
}

part eta_pos_37_hour_wheel_envelope() -> Solid<Exact> {
  -- Ratio-constrained 40 teeth: (12/36) * (10/40) = 1/12 hour-hand speed.
  common.toothed_disk(
    root_r = 1.95mm,
    tooth_depth = 0.16mm,
    tooth_width = 0.16mm,
    h = 0.3mm,
    bore_r = 0.75mm,
    teeth = 40,
  )
}

part eta_pos_38_date_driving_wheel_envelope() -> Solid<Exact> {
  -- Expert-estimated 24-tooth wheel; the date finger is modeled separately.
  union(
    common.toothed_disk(
      root_r = 1.7mm,
      tooth_depth = 0.14mm,
      tooth_width = 0.18mm,
      h = 0.28mm,
      bore_r = 0.2mm,
      teeth = 24,
    ),
    box(x = 0.35mm, y = 1.2mm, z = 0.22mm) |> at(dx = 0mm, dy = -1.8mm, dz = 0.24mm),
  )
}

part eta_pos_39_minute_train_bridge_envelope() -> Solid<Exact> {
  -- Local coordinates: the bridge is placed at (2.0, -0.65) turned -15deg, and
  -- the cannon pinion runs on the centre axis through it.
  cut(
    box(x = 5mm, y = 2.5mm, z = datum.minute_bridge_thickness()),
    union(
      cylinder(r = cannon_pinion_seat_radius() + datum.running_clearance(), h = 0.6mm)
        |> at(dx = -2.07mm, dy = 0.13mm, dz = 0mm),
      common.screw_clearance_hole(
        head_r = 0.47mm,
        head_h = 0.19mm,
        shank_r = 0.23mm,
        depth = datum.minute_bridge_thickness(),
      )
        |> at(dx = 1.86mm, dy = -0.83mm, dz = 0mm),
    ),
  )
}

part eta_pos_40_date_jumper_envelope() -> Solid<Exact> {
  box(x = 2.8mm, y = 0.55mm, z = 0.16mm)
}

part eta_pos_41_maintaining_plate_envelope() -> Solid<Exact> {
  box(x = 3mm, y = 1.5mm, z = 0.22mm)
}

part eta_pos_42_dial_support_envelope() -> Solid<Exact> {
  cut(cylinder(r = 12.8mm, h = 0.2mm), cylinder(r = 12.25mm, h = 0.4mm))
}

part eta_pos_43_key_bolt_envelope() -> Solid<Exact> {
  box(x = 1.2mm, y = 0.45mm, z = 0.16mm)
}

part dial_side_assembly() -> Assembly {
  together(
    eta_pos_32_setting_wheel_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = 6.957mm,
            y = -1.379mm,
            z = datum.calendar_band_floor_z() + 0.1mm,
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 204, g = 165, b = 62),
      ),
    eta_pos_33_cannon_pinion_envelope()
      |> place(
        frame = frame(
          origin = point(x = 0mm, y = 0mm, z = datum.calendar_band_floor_z() + 0.1mm),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 133, g = 143, b = 154),
      ),
    eta_pos_12_1_minute_train_driving_pinion()
      |> place(
