import "./components.cade" as common
import "./datums.cade" as datum

-- The minute train. The cannon pinion is not on the going train's arbor -- the
-- centre carries the SECONDS wheel -- so the minute hand is driven indirectly:
-- the second wheel, which turns once an hour, reaches through the plate to a
-- pinion on the dial side, an idler carries the drive round the hour wheel, and
-- the minute wheel turns the cannon pinion.
--
--   second dial pinion 12 -> idler 40 -> minute wheel 36 -> cannon pinion 12
--
-- Re-solved 2026-09-05 onto the measured layout: the driving pinion is on the
-- second wheel's arbor, which moved when the going train was re-derived from
-- the plate view, so the idler and the minute wheel moved with it.
--
-- An idler changes no ratio, and 12 into 12 is 1:1, so the cannon pinion turns
-- once an hour exactly as the second wheel does.
part eta_pos_12_1_minute_train_driving_pinion() -> Solid<Exact> {
  common.involute_disk(
    root_r = 0.475mm,
    bore_r = 0.13mm,
    flank_nx = 0.34093,
    flank_ny = 0.94009,
    flank_d = 0.26598mm,
    inner_x = 0.4275mm,
    tip_r = 0.7mm,
    h = 0.24mm,
    teeth = 12,
  )
}

part eta_pos_34_1_minute_train_idler() -> Solid<Exact> {
  common.involute_spoked_wheel(
    root_r = 1.875mm,
    rim_width = 0.24mm,
    hub_r = 0.44mm,
    bore_r = 0.2mm,
    spoke_width = 0.16mm,
    flank_nx = 0.27573,
    flank_ny = 0.96123,
    flank_d = 0.614mm,
    inner_x = 1.6875mm,
    tip_r = 2.1mm,
    h = 0.22mm,
    teeth = 40,
    spokes = 5,
  )
}

part eta_pos_32_setting_wheel_envelope() -> Solid<Exact> {
  -- Expert estimate: 24 teeth.
  common.involute_disk(
    root_r = 1.075mm,
    bore_r = 0.2mm,
    flank_nx = 0.29914,
    flank_ny = 0.95421,
    flank_d = 0.42133mm,
    inner_x = 0.9675mm,
    tip_r = 1.3mm,
    h = 0.25mm,
    teeth = 24,
  )
}

-- expert_estimate: the cannon pinion reaches from the calendar band down
-- through the dial to the minute-hand seat and no further. ETA gives the seat
-- itself: 0.900 +0.006/-0.004mm, so r = 0.45mm.
fn cannon_pinion_length() -> Len {
  1.3mm
}

fn cannon_pinion_seat_radius() -> Len {
  0.45mm
}

part eta_pos_33_cannon_pinion_envelope() -> Solid<Exact> {
  -- H2 0.90mm hand fitting with an estimated 12-tooth driving pinion.
  union(
    common.involute_disk(
      root_r = 0.475mm,
      bore_r = 0.18mm,
      flank_nx = 0.34093,
      flank_ny = 0.94009,
      flank_d = 0.26598mm,
      inner_x = 0.4275mm,
      tip_r = 0.7mm,
      h = 0.22mm,
      teeth = 12,
    ),
    cylinder(r = cannon_pinion_seat_radius(), h = cannon_pinion_length())
      |> at(dx = 0mm, dy = 0mm, dz = 0.11mm - cannon_pinion_length() / 2),
  )
}

part eta_pos_34_minute_wheel_envelope(pinion_phase: Angle) -> Solid<Exact> {
  -- The ring and the hour wheel overlap by 3.9mm in plan and do not mesh -- only
  -- the pinion does -- so the hour wheel runs a level above the ring. Square
  -- tooth blocks hid this; involute teeth are thicker at the pitch circle and
  -- brought it out.
  --
  -- The calendar band is only 0.39mm tall, so making room meant thinning both:
  -- ring 0.15 at 0.455-0.605, hour wheel 0.15 at 0.640-0.790, and a 0.30 pinion
  -- spanning 0.490-0.790 to reach from one to the other.
  --
  -- 36-tooth ring on module 0.100, which is what the 2.400mm centre distance to
  -- the cannon pinion and the 3.800mm to the idler both require, and a 10-leaf
  -- hour-driving pinion on 0.096. The ring and the pinion do not share a
  -- module because they do not share a mesh.
  union(
    common.involute_spoked_wheel(
      root_r = 1.675mm,
      rim_width = 0.22mm,
      hub_r = 0.44mm,
      bore_r = 0.2mm,
      spoke_width = 0.14mm,
      flank_nx = 0.28003,
      flank_ny = 0.95999,
      flank_d = 0.56656mm,
      inner_x = 1.5075mm,
      tip_r = 1.9mm,
      h = 0.15mm,
      teeth = 36,
      spokes = 5,
    ),
    common.involute_disk(
      root_r = 0.36mm,
      bore_r = 0.2mm,
      flank_nx = 0.35346,
      flank_ny = 0.93545,
      flank_d = 0.22814mm,
      inner_x = 0.324mm,
      tip_r = 0.576mm,
      h = 0.3mm,
      teeth = 10,
    )
      |> rotate(ax = 0, ay = 0, az = 1, angle = pinion_phase)
      |> at(dx = 0mm, dy = 0mm, dz = 0.11mm),
  )
}

part eta_pos_35_date_corrector_envelope() -> Solid<Exact> {
  common.involute_disk(
    root_r = 0.775mm,
    bore_r = 0.18mm,
    flank_nx = 0.31519,
    flank_ny = 0.94903,
    flank_d = 0.34578mm,
    inner_x = 0.6975mm,
    tip_r = 1mm,
    h = 0.22mm,
    teeth = 18,
  )
}

part eta_pos_36_date_indicator_envelope() -> Solid<Exact> {
  -- ETA drawing-supported: 23.30mm outside diameter and 31 internal teeth.
  common.internal_toothed_ring(
    outer_r = 11.65mm,
    root_r = 8.71mm,
    tooth_depth = 0.3mm,
    tooth_width = 0.32mm,
    h = 0.3mm,
    teeth = 31,
  )
}

part eta_pos_37_hour_wheel_envelope() -> Solid<Exact> {
  -- Ratio-constrained 40 teeth: (12/36) * (10/40) = 1/12 hour-hand speed.
  --
  -- Re-cut on a consistent module. The 10-leaf pinion above and this wheel have
  -- to share one, and the 2.400mm centre distance with 40 and 10 teeth fixes it
  -- at 0.096: pitch radii 1.920 and 0.480. The two were previously drawn with
  -- tooth depths that belonged to no common module at all.
  common.involute_disk(
    root_r = 1.8mm,
    bore_r = 0.75mm,
    flank_nx = 0.27573,
    flank_ny = 0.96123,
    flank_d = 0.58944mm,
    inner_x = 1.62mm,
    tip_r = 2.016mm,
    h = 0.15mm,
    teeth = 40,
  )
}

part eta_pos_38_date_driving_wheel_envelope() -> Solid<Exact> {
  -- Expert-estimated 24-tooth wheel; the date finger is modeled separately.
  union(
    common.involute_disk(
      root_r = 1.075mm,
      bore_r = 0.2mm,
      flank_nx = 0.29914,
      flank_ny = 0.95421,
      flank_d = 0.42133mm,
      inner_x = 0.9675mm,
      tip_r = 1.3mm,
      h = 0.28mm,
      teeth = 24,
    ),
    box(x = 0.35mm, y = 1.2mm, z = 0.22mm) |> at(dx = 0mm, dy = -1.8mm, dz = 0.24mm),
  )
}

part eta_pos_39_minute_train_bridge_envelope() -> Solid<Exact> {
  -- A strip from the cannon pinion out to its screw. Local +X runs along that
  -- line, so the cannon-pinion bore is at one end and the screw at the other:
  -- placed at (1.9500mm, -0.8000mm) turned -22.306deg, the bore lands on the
  -- movement axis and the screw on `datum`'s 907 axis.
  cut(
    box(x = 5.8154mm, y = 2.2mm, z = datum.minute_bridge_thickness()),
    union(
      cylinder(r = cannon_pinion_seat_radius() + datum.running_clearance(), h = 0.6mm)
        |> at(dx = 0mm - 2.1077mm, dy = 0mm, dz = 0mm),
      common.screw_clearance_hole(
        head_r = 0.47mm,
        head_h = 0.19mm,
        shank_r = 0.23mm,
        depth = datum.minute_bridge_thickness(),
      )
        |> at(dx = 2.1077mm, dy = 0mm, dz = 0mm),
    ),
  )
}

part eta_pos_40_date_jumper_envelope() -> Solid<Exact> {
  box(x = 2.8mm, y = 0.55mm, z = 0.16mm)
}

part eta_pos_41_maintaining_plate_envelope() -> Solid<Exact> {
  box(x = 3mm, y = 1.5mm, z = 0.22mm)
}

part eta_pos_42_dial_support_envelope() -> Solid<Exact> {
  cut(cylinder(r = 12.8mm, h = 0.2mm), cylinder(r = 12.25mm, h = 0.4mm))
}

part eta_pos_43_key_bolt_envelope() -> Solid<Exact> {
  box(x = 1.2mm, y = 0.45mm, z = 0.16mm)
}

