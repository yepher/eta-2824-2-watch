          ),
          axis = Z,
          angle = 25deg,
        ),
        color = rgb(r = 125, g = 135, b = 146),
      ),
    eta_pos_41_maintaining_plate_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = -7.4mm,
            y = -3.5mm,
            z = (datum.maintaining_plate_floor_z() + datum.maintaining_plate_top_z())
              / 2,
          ),
          axis = Z,
          angle = 25deg,
        ),
        color = rgb(r = 181, g = 178, b = 170),
