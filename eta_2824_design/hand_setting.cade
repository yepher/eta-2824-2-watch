import "./components.cade" as common
import "./datums.cade" as datum

-- ETA positions 2 and 3 ride on the stem and straddle the main plate in the
-- measured keyless slot. They are NOT in a dial-side pocket: the slot is a
-- through-cut, and the winding pinion stands proud of the train-side face
-- where the crown wheel's underside teeth meet it at 90 degrees. Page 6's
-- plate view shows the slot open through the plate, and the assembled
-- train-side views on pages 10 and 12 show the pinion standing in it.
part eta_pos_2_sliding_pinion_envelope() -> Solid<Exact> {
  -- An axially sliding clutch, not a second flat spur gear. Measured 1.60mm
  -- long over 1.45mm; the reduced centre is the yoke groove and the six dogs
  -- couple it to the winding pinion when the stem is pushed home.
  let clutch_body = union(
    common.bored_disk(r = 0.725mm, h = 0.3mm, bore_r = 0.31mm)
      |> at(dx = 0mm, dy = 0mm, dz = 0mm - 0.5mm),
    common.bored_disk(r = 0.46mm, h = 0.72mm, bore_r = 0.31mm),
    common.bored_disk(r = 0.725mm, h = 0.3mm, bore_r = 0.31mm)
      |> at(dx = 0mm, dy = 0mm, dz = 0.5mm),
  )
  let face_dog = box(x = 0.3mm, y = 0.22mm, z = 0.22mm)
    |> at(dx = 0.5mm, dy = 0mm, dz = 0.76mm)
    |> polar(n = 6, axis = Z)

  union(clutch_body, face_dog)
}

part eta_pos_3_winding_pinion_envelope() -> Solid<Exact> {
  -- The 90-degree interface to the crown wheel. Five teeth on the winding
  -- train's module 0.23: pitch radius 0.575, tip 0.805, which is the 1.45 to
  -- 1.60mm over the teeth that position 2 and 3 measure on the materials page.
  -- The teeth lean toward the crown-wheel axis rather than presenting a square
  -- spur flank, which is what makes the mesh a face-gear mesh and not two spur
  -- gears crossed at a right angle.
  let core = cut(
    cone(r1 = 0.44mm, r2 = datum.winding_pinion_tip_radius(), h = 0.62mm),
    cylinder(r = 0.31mm, h = 0.9mm),
  )
  let inclined_leaf = box(x = 0.44mm, y = 0.2mm, z = 0.46mm)
    |> rotate(ax = 0, ay = 1, az = 0, angle = 20deg)
    |> at(dx = 0.62mm, dy = 0mm, dz = 0.04mm)
    |> polar(n = 5, axis = Z)
  let collar = common.bored_disk(r = 0.5mm, h = 0.28mm, bore_r = 0.31mm)
    |> at(dx = 0mm, dy = 0mm, dz = 0mm - 0.45mm)
  let dog_pocket = box(x = 0.34mm, y = 0.26mm, z = 0.2mm)
    |> at(dx = 0.5mm, dy = 0mm, dz = 0mm - 0.36mm)
    |> polar(n = 6, axis = Z)

  cut(union(core, inclined_leaf, collar), dog_pocket)
}

part eta_pos_4_winding_stem_envelope() -> Solid<Exact> {
  -- Built along local Z and laid onto the +X stem axis, so its placement origin
  -- is the movement centre and every local Z below reads directly as a world X.
  -- That is worth the small oddity of a part whose origin is not inside it: the
  -- square, the pinion seats and the case tube can then be stated at the same X
  -- as the parts that sit on them.
  --
  -- Position 4 Var measures 17.13mm overall on the materials page. ETA supplies
  -- the stem over-length for the watchmaker to cut to the case, so that is a
  -- supply length, not a fitted one; what is modelled here is the fitted stem,
  -- running from its pivot in the plate out to the crown at X = 20.
  let stem_blank = union(
    -- pivot, in the plate at the inboard end of the keyless slot
    cylinder(r = 0.18mm, h = 0.48mm) |> at(dx = 0mm, dy = 0mm, dz = 6.51mm),
    cylinder(r = 0.28mm, h = 0.3mm) |> at(dx = 0mm, dy = 0mm, dz = 6.9mm),
    -- the square the sliding pinion rides on
    box(x = 0.55mm, y = 0.55mm, z = 1.3mm) |> at(dx = 0mm, dy = 0mm, dz = 7.7mm),
    -- the round the winding pinion turns freely on
    cylinder(r = 0.28mm, h = 0.95mm) |> at(dx = 0mm, dy = 0mm, dz = 8.825mm),
    -- shoulder, setting-lever groove, shoulder
    cylinder(r = 0.4mm, h = 0.45mm) |> at(dx = 0mm, dy = 0mm, dz = 9.525mm),
    cylinder(r = 0.22mm, h = 0.4mm) |> at(dx = 0mm, dy = 0mm, dz = 9.95mm),
    cylinder(r = 0.4mm, h = 0.45mm) |> at(dx = 0mm, dy = 0mm, dz = 10.375mm),
    -- the body, out through the plate rim and the case tube to the crown
    cylinder(r = 0.3mm, h = 9.4mm) |> at(dx = 0mm, dy = 0mm, dz = 15.3mm),
  )

  stem_blank |> rotate(ax = 0, ay = 1, az = 0, angle = 90deg)
}

part eta_pos_5_corrector_lever_envelope() -> Solid<Exact> {
  box(x = 3.2mm, y = 0.65mm, z = 0.22mm)
}

part eta_pos_6_setting_lever_envelope() -> Solid<Exact> {
  let lever = union(
    box(x = 3.25mm, y = 0.56mm, z = 0.22mm) |> at(dx = 0.35mm, dy = 0mm, dz = 0mm),
    cylinder(r = 0.72mm, h = 0.22mm) |> at(dx = -1.35mm, dy = 0mm, dz = 0mm),
  )
  let pivot = cylinder(r = 0.24mm, h = 0.4mm) |> at(dx = -1.35mm, dy = 0mm, dz = 0mm)

  cut(lever, pivot)
}

part eta_pos_7_yoke_envelope() -> Solid<Exact> {
  -- The two jaws sit in the reduced-radius groove on position 2.
  let yoke_blank = union(
    box(x = 2.8mm, y = 0.34mm, z = 0.2mm) |> at(dx = 0.15mm, dy = -0.62mm, dz = 0mm),
    box(x = 2.8mm, y = 0.34mm, z = 0.2mm) |> at(dx = 0.15mm, dy = 0.62mm, dz = 0mm),
    cylinder(r = 0.9mm, h = 0.2mm) |> at(dx = -1.25mm, dy = 1.55mm, dz = 0mm),
  )
  let fork_relief = cylinder(r = 0.51mm, h = 0.4mm)
    |> at(dx = 1.55mm, dy = 0mm, dz = 0mm)
  -- The yoke pivots beside the stem, never on it: a boss on the stem axis
  -- would have the stem running through its own pivot.
  let pivot_clearance = cylinder(r = 0.23mm, h = 0.4mm)
    |> at(dx = -1.25mm, dy = 1.55mm, dz = 0mm)

  cut(yoke_blank, union(fork_relief, pivot_clearance))
}

part eta_pos_8_setting_lever_jumper_envelope() -> Solid<Exact> {
  box(x = 4.8mm, y = 0.55mm, z = 0.16mm)
}

-- The two pinions sit in the measured through-slot on the stem axis; the
-- levers lie under them in the shallow dial-side pocket. The winding pinion's
-- X is not chosen: it is where the crown wheel's pitch circle crosses the stem
-- axis, and it lands 0.14mm from the centre of the slot ETA actually cut.
part keyless_state_assembly(stem_x: Len, sliding_x: Len, yoke_x: Len) -> Assembly {
  together(
    eta_pos_2_sliding_pinion_envelope()
      |> place(
        frame = frame(
          origin = point(x = sliding_x, y = 0mm, z = datum.stem_axis_z()),
          axis = Y,
          angle = 90deg,
        ),
        color = rgb(r = 170, g = 176, b = 184),
      ),
    eta_pos_3_winding_pinion_envelope()
      |> place(
        frame = frame(
          origin = point(x = 8.823mm, y = 0mm, z = datum.stem_axis_z()),
          axis = Y,
          angle = 90deg,
        ),
        color = rgb(r = 198, g = 158, b = 66),
      ),
    eta_pos_4_winding_stem_envelope()
      |> place(
        frame = frame(
          origin = point(x = stem_x, y = 0mm, z = datum.stem_axis_z()),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 150, g = 158, b = 168),
      ),
    eta_pos_5_corrector_lever_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = 6.3mm,
            y = 2.5mm,
            z = datum.keyless_pocket_floor_z() - 0.13mm,
          ),
          axis = Z,
          angle = 22deg,
        ),
        color = rgb(r = 165, g = 173, b = 183),
      ),
    eta_pos_6_setting_lever_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = 6.9mm,
            y = -2.4mm,
            z = datum.keyless_pocket_floor_z() - 0.13mm,
          ),
          axis = Z,
          angle = -18deg,
        ),
        color = rgb(r = 148, g = 156, b = 166),
      ),
    -- The yoke's jaws sit in the sliding pinion's groove, so its level is set
    -- by that groove and not by the pocket floor.
    eta_pos_7_yoke_envelope()
      |> place(
        frame = frame(
          origin = point(x = yoke_x, y = 0mm, z = datum.stem_axis_z() - 0.36mm),
          axis = Z,
          angle = 180deg,
        ),
        color = rgb(r = 133, g = 142, b = 153),
      ),
    eta_pos_8_setting_lever_jumper_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = 5.8mm,
            y = -3.1mm,
            z = datum.keyless_pocket_floor_z() - 0.32mm,
          ),
          axis = Z,
          angle = -24deg,
        ),
        color = rgb(r = 105, g = 115, b = 127),
      ),
  )
}

part hand_setting_assembly() -> Assembly {
  keyless_state_assembly(stem_x = 0mm, sliding_x = 7.7mm, yoke_x = 7.7mm)
}
