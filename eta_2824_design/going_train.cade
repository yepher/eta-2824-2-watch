import "./components.cade" as common

part eta_pos_9_escape_wheel_envelope() -> Solid<Exact> {
  -- Published secondary evidence: 20 escape teeth. The 7-leaf pinion is an
  -- expert estimate constrained by the 28,800-vph train hypothesis below.
  union(
    common.spoked_wheel(
      root_r = 1.38mm,
      rim_width = 0.2mm,
      tooth_depth = 0.12mm,
      tooth_width = 0.16mm,
      hub_r = 0.34mm,
      bore_r = 0.1mm,
      spoke_width = 0.1mm,
      h = 0.18mm,
      teeth = 20,
      spokes = 5,
    ),
    common.toothed_disk(
      root_r = 0.29mm,
      tooth_depth = 0.06mm,
      tooth_width = 0.14mm,
      h = 0.34mm,
      bore_r = 0.1mm,
      teeth = 7,
    )
      |> at(dx = 0mm, dy = 0mm, dz = 0.26mm),
  )
}

part eta_pos_10_intermediate_wheel_envelope() -> Solid<Exact> {
  -- Expert estimate: 84 wheel teeth / 7 pinion leaves.
  union(
    common.spoked_wheel(
      root_r = 1.73mm,
      rim_width = 0.2mm,
      tooth_depth = 0.12mm,
      tooth_width = 0.1mm,
      hub_r = 0.4mm,
      bore_r = 0.11mm,
      spoke_width = 0.13mm,
      h = 0.22mm,
      teeth = 84,
      spokes = 6,
    ),
    common.toothed_disk(
      root_r = 0.29mm,
      tooth_depth = 0.06mm,
      tooth_width = 0.14mm,
      h = 0.38mm,
      bore_r = 0.11mm,
      teeth = 7,
    )
      |> at(dx = 0mm, dy = 0mm, dz = 0.3mm),
  )
}

