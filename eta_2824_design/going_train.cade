        ),
        color = rgba(r = 190, g = 20, b = 62, a = 210),
      ),
    eta_pos_13_train_bridge_jewel()
      |> place(
        frame = frame(
          origin = point(x = 4.3mm, y = 2.5mm, z = 2.15mm),
          axis = Z,
          angle = 0deg,
        ),
        color = rgba(r = 190, g = 20, b = 62, a = 210),
      ),
    eta_pos_13_train_bridge_jewel()
      |> place(
        frame = frame(
          origin = point(x = 6.6mm, y = 6.2mm, z = 2.15mm),
          axis = Z,
          angle = 0deg,
        ),
        color = rgba(r = 190, g = 20, b = 62, a = 210),
      ),
    eta_pos_13_train_bridge_jewel()
      |> place(
        frame = frame(
          origin = point(x = 9.5mm, y = 3.6mm, z = 2.15mm),
          axis = Z,
          angle = 0deg,
        ),
        color = rgba(r = 190, g = 20, b = 62, a = 210),
      ),
    going_train_pivot_arbor()
      |> place(
        frame = frame(
          origin = point(x = -1.2mm, y = 2.5mm, z = 1.4mm),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 136, g = 145, b = 155),
      ),
    going_train_pivot_arbor()
      |> place(
        frame = frame(
          origin = point(x = 4.3mm, y = 2.5mm, z = 1.4mm),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 136, g = 145, b = 155),
      ),
    going_train_pivot_arbor()
      |> place(
        frame = frame(
          origin = point(x = 6.6mm, y = 6.2mm, z = 1.4mm),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 136, g = 145, b = 155),
      ),
    going_train_pivot_arbor()
      |> place(
        frame = frame(
          origin = point(x = 9.5mm, y = 3.6mm, z = 1.4mm),
          axis = Z,
