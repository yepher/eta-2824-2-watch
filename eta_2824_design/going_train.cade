part eta_pos_13_train_bridge_envelope() -> Solid<Exact> {
  let bridge_blank = union(
    cylinder(r = 2mm, h = 0.35mm) |> at(dx = -5.4mm, dy = -1.3mm, dz = 0mm),
    cylinder(r = 1.8mm, h = 0.35mm) |> at(dx = 0.1mm, dy = -1.3mm, dz = 0mm),
    cylinder(r = 1.6mm, h = 0.35mm) |> at(dx = 2.4mm, dy = 2.4mm, dz = 0mm),
    cylinder(r = 1.5mm, h = 0.35mm) |> at(dx = 5.3mm, dy = -0.2mm, dz = 0mm),
    box(x = 11mm, y = 2.1mm, z = 0.35mm) |> at(dx = 0mm, dy = -1.2mm, dz = 0mm),
    box(x = 2.2mm, y = 5mm, z = 0.35mm) |> at(dx = 1.2mm, dy = 0.7mm, dz = 0mm),
    box(x = 4mm, y = 1.8mm, z = 0.35mm) |> at(dx = 3.5mm, dy = 1mm, dz = 0mm),
  )
  let bearing_seats = union(
    cylinder(r = 0.48mm, h = 0.55mm) |> at(dx = -5.4mm, dy = -1.3mm, dz = 0mm),
    cylinder(r = 0.48mm, h = 0.55mm) |> at(dx = 0.1mm, dy = -1.3mm, dz = 0mm),
    cylinder(r = 0.48mm, h = 0.55mm) |> at(dx = 2.4mm, dy = 2.4mm, dz = 0mm),
    cylinder(r = 0.48mm, h = 0.55mm) |> at(dx = 5.3mm, dy = -0.2mm, dz = 0mm),
  )
  let screw_clearances = union(
    cylinder(r = 0.24mm, h = 0.55mm) |> at(dx = -6mm, dy = -2.3mm, dz = 0mm),
    cylinder(r = 0.24mm, h = 0.55mm) |> at(dx = 6.1mm, dy = -1mm, dz = 0mm),
  )

  cut(bridge_blank, union(bearing_seats, screw_clearances))
}

part eta_pos_13_train_bridge_jewel() -> Solid<Exact> {
  common.jewel_ring(r = 0.48mm, h = 0.3mm, bore_r = 0.105mm)
}

part going_train_pivot_arbor() -> Solid<Exact> {
  cylinder(r = 0.085mm, h = 1.85mm)
}

part going_train_assembly() -> Assembly {
  together(
    eta_pos_9_escape_wheel_envelope()
      |> place(
        frame = frame(
          origin = point(x = 9.5mm, y = 3.6mm, z = 1.55mm),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 214, g = 172, b = 64),
      ),
    eta_pos_10_intermediate_wheel_envelope()
      |> place(
        frame = frame(
          origin = point(x = 6.6mm, y = 6.2mm, z = 1.55mm),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 203, g = 158, b = 52),
      ),
    eta_pos_11_third_wheel_envelope()
      |> place(
        frame = frame(
          origin = point(x = 4.3mm, y = 2.5mm, z = 1.55mm),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 224, g = 184, b = 74),
      ),
    eta_pos_12_second_wheel_envelope()
      |> place(
        frame = frame(
          origin = point(x = -1.2mm, y = 2.5mm, z = 1.55mm),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 194, g = 147, b = 38),
      ),
    eta_pos_13_train_bridge_envelope()
      |> place(
