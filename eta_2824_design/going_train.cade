  -- Expert estimate: 80 wheel teeth / 10 pinion leaves.
  union(
    common.spoked_wheel(
      root_r = 2.84mm,
      rim_width = 0.28mm,
      tooth_depth = 0.16mm,
      tooth_width = 0.15mm,
