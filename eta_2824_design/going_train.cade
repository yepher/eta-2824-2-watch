          origin = point(x = 4.2mm, y = 3.8mm, z = 2.15mm),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 184, g = 180, b = 170),
      ),
    eta_pos_13_train_bridge_jewel()
      |> place(
        frame = frame(
          origin = point(x = -1.2mm, y = 2.5mm, z = 2.15mm),
          axis = Z,
