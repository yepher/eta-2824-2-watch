import "./components.cade" as common
import "./datums.cade" as datum

-- ETA positions 9 to 13: the going train.
--
-- Re-derived 2026-09-05 (second time) on MEASURED bearing centres. Position
-- 1 Var on page 6 of the ETA technical communication is an orthographic view
-- of the main plate at the published 25.60mm diameter with the jewels
-- coloured, so the centres are read off the drawing rather than solved from
-- assumed tooth counts. `tools/measure_plate_layout.py` reproduces them and
-- `datums.cade` holds them.
--
-- The tooth counts are then the ones that close 28,800 A/h with the second
-- wheel turning once an hour, and the module of each mesh falls out of the
-- measured centre distance rather than being chosen:
--
--   barrel 74              / second pinion 12       C 6.9136  module 0.16078
--   second 64              / third pinion 8         C 3.7317  module 0.10366
--   third 75               / fourth pinion 10       C 3.6895  module 0.08681
--   fourth 96              / escape pinion 6        C 3.5993  module 0.07057
--
-- second 64 / third pinion 8   = 8      -> third  1 turn per 7.5 min
-- third  75 / fourth pinion 10 = 7.5    -> fourth 1 turn per minute
-- fourth 96 / escape pinion 6  = 16     -> escape 16 turns per minute
-- 16 turns/min * 15 teeth * 2           = 28,800 A/h
-- barrel 74 / second pinion 12          -> 1 barrel turn per 6.17h, about
--                                          39h at 6.3 usable turns
--
-- The tip diameters these modules produce land within 0.07mm of the
-- diameters measured independently off the same page, which is the strongest
-- cross-check in the model: two unrelated routes to the same geometry.
--
-- The fourth wheel is the CENTRE SECONDS wheel and sits on the movement
-- axis. The cannon pinion is a tube around its arbor.
--
-- Each mesh is phased. `polar` puts a tooth at 0deg, so a wheel is placed
-- turned to lay a tooth on its line of centres and the pinion it drives is
-- turned half a tooth pitch off it. A wheel's disc phase (its placement
-- angle) and its pinion phase are independent, which is what lets every
-- mesh in the chain be phased at once.
fn module_barrel_second() -> Len {
  0.16078mm
}

fn module_second_third() -> Len {
  0.10366mm
}

fn module_third_fourth() -> Len {
  0.08681mm
}

fn module_fourth_escape() -> Len {
  0.07057mm
}

part eta_pos_12_second_wheel_envelope(pinion_phase: Angle) -> Solid<Exact> {
  -- 64 teeth on module 0.10366 driving the third pinion. Its own 12-leaf
  -- pinion on module 0.16078 is driven by the barrel's great wheel, which is
  -- not on a train plane: it sits just above the plate's train face to clear
  -- the crown wheel's underside teeth. The pinion is short and drops to meet
  -- it, stopping clear of the jewel below.
  union(
    common.involute_spoked_wheel(
      root_r = 3.1875mm,
      rim_width = 0.1866mm,
      hub_r = 0.72mm,
      bore_r = 0.105mm,
      spoke_width = 0.1451mm,
      flank_nx = 0.30333,
      flank_ny = 0.95288,
      flank_d = 1.07484mm,
      inner_x = 2.8684mm,
      tip_r = 3.4203mm,
      h = datum.train_wheel_thickness(),
      teeth = 64,
      spokes = 6,
    ),
    common.involute_disk(
      root_r = 0.7637mm,
      bore_r = 0.105mm,
      flank_nx = 0.34093,
      flank_ny = 0.94009,
      flank_d = 0.42769mm,
      inner_x = 0.6874mm,
      tip_r = 1.1256mm,
      h = 0.16mm,
      teeth = 12,
    )
      |> rotate(ax = 0, ay = 0, az = 1, angle = pinion_phase)
      |> at(dx = 0mm, dy = 0mm, dz = datum.barrel_wheel_z() - datum.train_level_2_z()),
  )
}

part eta_pos_11_third_wheel_envelope(pinion_phase: Angle) -> Solid<Exact> {
  -- 75 teeth on module 0.08681 driving the fourth pinion; its own 8-leaf
  -- pinion on module 0.10366 is driven by the second wheel, one plane below.
  union(
    common.involute_spoked_wheel(
      root_r = 3.1469mm,
      rim_width = 0.16mm,
      hub_r = 0.63mm,
      bore_r = 0.105mm,
      spoke_width = 0.1215mm,
      flank_nx = 0.30975,
      flank_ny = 0.95082,
      flank_d = 1.06664mm,
      inner_x = 2.8319mm,
      tip_r = 3.3418mm,
      h = datum.train_wheel_thickness(),
      teeth = 75,
      spokes = 6,
    ),
    common.involute_disk(
      root_r = 0.2851mm,
      bore_r = 0.05mm,
      flank_nx = 0.36933,
      flank_ny = 0.9293,
      flank_d = 0.2154mm,
      inner_x = 0.2565mm,
      tip_r = 0.5182mm,
      h = 0.4mm,
      teeth = 8,
    )
      |> rotate(ax = 0, ay = 0, az = 1, angle = pinion_phase)
      |> at(dx = 0mm, dy = 0mm, dz = 0mm - 0.19mm),
  )
}

part eta_pos_10_centre_seconds_wheel_envelope(pinion_phase: Angle) -> Solid<Exact> {
  -- The centre seconds wheel: 96 teeth on module 0.07057 driving the escape
  -- pinion. Turns once a minute and carries the seconds hand on the arbor
  -- through the movement centre. Its 10-leaf pinion on module 0.08681 is
  -- driven by the third wheel one plane below.
  union(
    common.involute_spoked_wheel(
      root_r = 3.2993mm,
      rim_width = 0.16mm,
      hub_r = 0.54mm,
      bore_r = 0.105mm,
      spoke_width = 0.12mm,
      flank_nx = 0.31745,
      flank_ny = 0.94827,
      flank_d = 1.12376mm,
      inner_x = 2.9696mm,
      tip_r = 3.4583mm,
      h = datum.train_wheel_thickness(),
      teeth = 96,
      spokes = 5,
    ),
    common.involute_disk(
      root_r = 0.3255mm,
      bore_r = 0.105mm,
      flank_nx = 0.35346,
      flank_ny = 0.93545,
      flank_d = 0.20628mm,
      inner_x = 0.293mm,
      tip_r = 0.5208mm,
      h = 0.4mm,
      teeth = 10,
    )
      |> rotate(ax = 0, ay = 0, az = 1, angle = pinion_phase)
      |> at(dx = 0mm, dy = 0mm, dz = 0mm - 0.19mm),
  )
}

part eta_pos_9_escape_wheel_envelope(pinion_phase: Angle) -> Solid<Exact> {
  -- Measured: position 9 is 4.94mm over the tips, so 2.47mm tip radius. The
  -- 15 teeth are the count 28,800 A/h requires of a Swiss lever escapement
  -- at 16 escape turns per minute. A club tooth's radius is not set by a
  -- module -- these teeth meet the pallet stones, not another wheel -- so it
  -- follows the pallet geometry in escapement.cade.
  -- The 6-leaf pinion is on module 0.07057 and is cut on the arbor, so
  -- it is drawn nearly solid rather than bored for one.
  union(
    common.spoked_wheel(
      root_r = 2.1mm,
      rim_width = 0.18mm,
      tooth_depth = 0.37mm,
      tooth_width = 0.11mm,
      hub_r = 0.34mm,
      bore_r = 0.105mm,
      spoke_width = 0.12mm,
      h = datum.train_wheel_thickness(),
      teeth = 15,
      spokes = 5,
    ),
    common.involute_disk(
      root_r = 0.1235mm,
      bore_r = 0.05mm,
      flank_nx = 0.39013,
      flank_ny = 0.92076,
      flank_d = 0.12395mm,
      inner_x = 0.1112mm,
      tip_r = 0.2823mm,
      h = 0.4mm,
      teeth = 6,
    )
      |> rotate(ax = 0, ay = 0, az = 1, angle = pinion_phase)
      |> at(dx = 0mm, dy = 0mm, dz = 0mm - 0.19mm),
  )
}

part eta_pos_13_train_bridge_envelope() -> Solid<Exact> {
  -- Spans the four upper pivots and stands on two feet that reach the plate,
  -- with the screw's clearance hole through each foot. The feet were solved
  -- against the placed geometry: each clears every wheel's tip circle, the
  -- barrel, the balance and the crown wheel by at least 1.0mm. Local
  -- coordinates are relative to the bridge's placement at (-2.2820mm, 0.8683mm).
  let bosses = union(
    cylinder(r = 1.05mm, h = datum.train_bridge_thickness())
      |> at(dx = 0mm - 1.793mm, dy = 5.0887mm, dz = 0mm),
    cylinder(r = 1.05mm, h = datum.train_bridge_thickness())
      |> at(dx = 0mm - 0.456mm, dy = 1.6047mm, dz = 0mm),
    cylinder(r = 1.05mm, h = datum.train_bridge_thickness())
      |> at(dx = 2.282mm, dy = 0mm - 0.8683mm, dz = 0mm),
    cylinder(r = 1.05mm, h = datum.train_bridge_thickness())
      |> at(dx = 0mm - 0.697mm, dy = 0mm - 2.8883mm, dz = 0mm),
    cylinder(r = 0.95mm, h = datum.train_bridge_thickness())
      |> at(dx = 0mm - 5.518mm, dy = 1.3517mm, dz = 0mm),
    cylinder(r = 0.95mm, h = datum.train_bridge_thickness())
      |> at(dx = 6.182mm, dy = 0mm - 4.2883mm, dz = 0mm),
  )
  let spans = union(
    box(x = 5.2764mm, y = 1.4mm, z = datum.train_bridge_thickness())
      |> rotate(ax = 0, ay = 0, az = 1, angle = 45.092deg)
      |> at(dx = 0mm - 3.6555mm, dy = 3.2202mm, dz = 0mm),
    box(x = 3.7317mm, y = 1.4mm, z = datum.train_bridge_thickness())
      |> rotate(ax = 0, ay = 0, az = 1, angle = -69.005deg)
      |> at(dx = 0mm - 1.1245mm, dy = 3.3467mm, dz = 0mm),
    box(x = 3.6895mm, y = 1.4mm, z = datum.train_bridge_thickness())
      |> rotate(ax = 0, ay = 0, az = 1, angle = -42.089deg)
      |> at(dx = 0.913mm, dy = 0.3682mm, dz = 0mm),
    box(x = 5.1871mm, y = 1.4mm, z = datum.train_bridge_thickness())
      |> rotate(ax = 0, ay = 0, az = 1, angle = -41.248deg)
      |> at(dx = 4.232mm, dy = 0mm - 2.5783mm, dz = 0mm),
    box(x = 4.4995mm, y = 1.4mm, z = datum.train_bridge_thickness())
      |> rotate(ax = 0, ay = 0, az = 1, angle = -93.07deg)
      |> at(dx = 0mm - 0.5765mm, dy = 0mm - 0.6418mm, dz = 0mm),
  )
  let jewel_seats = union(
    cylinder(
      r = 0.48mm + datum.jewel_seat_clearance(),
      h = datum.train_bridge_thickness() + 0.4mm,
    )
      |> at(dx = 0mm - 1.793mm, dy = 5.0887mm, dz = 0mm),
    cylinder(
      r = 0.48mm + datum.jewel_seat_clearance(),
      h = datum.train_bridge_thickness() + 0.4mm,
    )
      |> at(dx = 0mm - 0.456mm, dy = 1.6047mm, dz = 0mm),
    cylinder(
      r = 0.48mm + datum.jewel_seat_clearance(),
      h = datum.train_bridge_thickness() + 0.4mm,
    )
      |> at(dx = 2.282mm, dy = 0mm - 0.8683mm, dz = 0mm),
    cylinder(
      r = 0.48mm + datum.jewel_seat_clearance(),
      h = datum.train_bridge_thickness() + 0.4mm,
    )
      |> at(dx = 0mm - 0.697mm, dy = 0mm - 2.8883mm, dz = 0mm),
  )
  let feet = union(
    common.bridge_foot(
      r = datum.bridge_foot_radius(),
      h = datum.train_bridge_underside_z() - datum.plate_train_face_z(),
      hole_r = 0.24mm,
    )
      |> at(
        dx = 0mm - 5.518mm,
        dy = 1.3517mm,
        dz = 0mm - datum.train_bridge_thickness() / 2
          - (datum.train_bridge_underside_z() - datum.plate_train_face_z()) / 2,
      ),
    common.bridge_foot(
      r = datum.bridge_foot_radius(),
      h = datum.train_bridge_underside_z() - datum.plate_train_face_z(),
      hole_r = 0.24mm,
    )
      |> at(
        dx = 6.182mm,
        dy = 0mm - 4.2883mm,
        dz = 0mm - datum.train_bridge_thickness() / 2
          - (datum.train_bridge_underside_z() - datum.plate_train_face_z()) / 2,
      ),
  )
  let screw_holes = union(
    common.screw_clearance_hole(
      head_r = 0.5mm,
      head_h = 0.18mm,
      shank_r = 0.24mm,
      depth = datum.train_bridge_thickness(),
    )
      |> at(dx = 0mm - 5.518mm, dy = 1.3517mm, dz = 0mm),
    common.screw_clearance_hole(
      head_r = 0.5mm,
      head_h = 0.18mm,
      shank_r = 0.24mm,
      depth = datum.train_bridge_thickness(),
    )
      |> at(dx = 6.182mm, dy = 0mm - 4.2883mm, dz = 0mm),
  )

  cut(union(bosses, spans, feet), union(jewel_seats, screw_holes))
}

part eta_pos_13_train_bridge_jewel() -> Solid<Exact> {
  common.jewel_ring(r = 0.48mm, h = 0.3mm, bore_r = 0.115mm)
}

part going_train_pivot_arbor() -> Solid<Exact> {
  cylinder(
    r = 0.105mm,
    h = datum.train_bridge_underside_z() - datum.plate_train_face_z() + 0.5mm,
  )
}

part escape_wheel_assembly() -> Assembly {
  eta_pos_9_escape_wheel_envelope(pinion_phase = 64.14deg)
    |> place(
      frame = frame(
        origin = point(
          x = 0mm - 2.979mm,
          y = 0mm - 2.02mm,
          z = datum.train_level_1_z(),
        ),
        axis = Z,
        angle = 0deg,
      ),
      color = rgb(r = 214, g = 172, b = 64),
    )
}

part going_train_assembly() -> Assembly {
  together(
    escape_wheel_assembly(),
    eta_pos_10_centre_seconds_wheel_envelope(pinion_phase = 301.771deg)
      |> place(
        frame = frame(
          origin = point(x = 0mm, y = 0mm, z = datum.train_level_4_z()),
          axis = Z,
          angle = 214.14deg,
        ),
        color = rgb(r = 203, g = 158, b = 52),
      ),
    eta_pos_11_third_wheel_envelope(pinion_phase = 175.583deg)
      |> place(
        frame = frame(
          origin = point(x = 0mm - 2.738mm, y = 2.473mm, z = datum.train_level_3_z()),
          axis = Z,
          angle = 317.911deg,
        ),
        color = rgb(r = 224, g = 184, b = 74),
      ),
    eta_pos_12_second_wheel_envelope(pinion_phase = 81.917deg)
      |> place(
        frame = frame(
          origin = point(x = 0mm - 4.075mm, y = 5.957mm, z = datum.train_level_2_z()),
          axis = Z,
          angle = 290.995deg,
        ),
        color = rgb(r = 194, g = 147, b = 38),
      ),
    eta_pos_13_train_bridge_envelope()
      |> place(
        frame = frame(
          origin = point(
            x = 0mm - 2.282mm,
            y = 0.8683mm,
            z = (datum.train_bridge_underside_z() + datum.train_bridge_top_z()) / 2,
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 184, g = 180, b = 170),
      ),
    eta_pos_13_train_bridge_jewel()
      |> place(
        frame = frame(
          origin = point(
            x = 0mm - 4.075mm,
            y = 5.957mm,
            z = datum.train_bridge_underside_z() + 0.15mm,
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgba(r = 190, g = 20, b = 62, a = 210),
      ),
    eta_pos_13_train_bridge_jewel()
      |> place(
        frame = frame(
          origin = point(
            x = 0mm - 2.738mm,
            y = 2.473mm,
            z = datum.train_bridge_underside_z() + 0.15mm,
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgba(r = 190, g = 20, b = 62, a = 210),
      ),
    eta_pos_13_train_bridge_jewel()
      |> place(
        frame = frame(
          origin = point(
            x = 0mm,
            y = 0mm,
            z = datum.train_bridge_underside_z() + 0.15mm,
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgba(r = 190, g = 20, b = 62, a = 210),
      ),
    eta_pos_13_train_bridge_jewel()
      |> place(
        frame = frame(
          origin = point(
            x = 0mm - 2.979mm,
            y = 0mm - 2.02mm,
            z = datum.train_bridge_underside_z() + 0.15mm,
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgba(r = 190, g = 20, b = 62, a = 210),
      ),
    going_train_pivot_arbor()
      |> place(
        frame = frame(
          origin = point(
            x = 0mm - 4.075mm,
            y = 5.957mm,
            z = (datum.plate_train_face_z() + datum.train_bridge_underside_z()) / 2,
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 136, g = 145, b = 155),
      ),
    going_train_pivot_arbor()
      |> place(
        frame = frame(
          origin = point(
            x = 0mm - 2.738mm,
            y = 2.473mm,
            z = (datum.plate_train_face_z() + datum.train_bridge_underside_z()) / 2,
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 136, g = 145, b = 155),
      ),
    going_train_pivot_arbor()
      |> place(
        frame = frame(
          origin = point(
            x = 0mm,
            y = 0mm,
            z = (datum.plate_train_face_z() + datum.train_bridge_underside_z()) / 2,
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 136, g = 145, b = 155),
      ),
    going_train_pivot_arbor()
      |> place(
        frame = frame(
          origin = point(
            x = 0mm - 2.979mm,
            y = 0mm - 2.02mm,
            z = (datum.plate_train_face_z() + datum.train_bridge_underside_z()) / 2,
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgb(r = 136, g = 145, b = 155),
      ),
  )
}
