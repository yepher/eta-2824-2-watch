-- Datums and the axial budget for the ETA 2824-2 reconstruction.
--
-- This file holds no geometry that ships. Every entry is a named quantity that
-- the subsystem files call, so a level moves in one edit instead of eighty, and
-- so no leaf part carries an unexplained coordinate literal.
--
-- Convention, as stated in ASSUMPTIONS.md:
--   origin   movement centre, on the DIAL SEAT plane
--   +X       toward 3 o'clock and the winding stem
--   +Y       toward 12 o'clock
--   +Z       from the dial side toward the rotor
--
-- The datum choice matters: with z = 0 at the dial seat the whole movement
-- occupies 0 <= z <= 4.60mm, so the published overall height stops being a
-- number in a document and becomes a constraint the model can be checked
-- against. `movement_stack_diagnostic` in this file is that check.
--
-- Evidence classes used below: `published` (ETA manufacturing information),
-- `comparative` (another calibre in the same base family, identified as such),
-- `derived` (arithmetic on the two above), `expert_estimate` (horological
-- practice, constrained by neighbouring geometry).
-- ---------------------------------------------------------------- envelope
-- published: ETA manufacturing information for the 2824-2.
fn movement_diameter() -> Len {
  26mm
}

-- published: the casing seat, 25.60mm.
fn casing_diameter() -> Len {
  25.6mm
}

-- published: overall height over the oscillating weight.
fn movement_height() -> Len {
  4.6mm
}

-- comparative: the ETA 2801-2 is this calibre's base ebauche without the
-- automatic module and is 3.35mm high. It fixes the plane at which the
-- automatic works mount, which no photograph of a 2824-2 can give.
fn base_movement_height() -> Len {
  3.35mm
}

-- derived: everything the automatic module is allowed to occupy.
fn automatic_module_height() -> Len {
  movement_height() - base_movement_height()
}

fn movement_radius() -> Len {
  movement_diameter() / 2
}

fn casing_radius() -> Len {
  casing_diameter() / 2
}

-- expert_estimate: the main plate is turned down from the 26.00mm blank to
-- clear the 25.60mm casing seat.
fn main_plate_radius() -> Len {
  casing_radius()
}

-- ------------------------------------------------------------- dial side
-- The datum plane itself. The dial rests here, on its feet and on the date
-- indicator maintaining plate.
fn dial_seat_z() -> Len {
  0mm
}

-- expert_estimate: the calendar platform, the date indicator and the hour
-- wheel all live between the dial seat and the plate. 0.85mm is the shallowest
-- stack that takes a 0.30mm date ring, its maintaining plate, and the hour
-- wheel running under it with working clearance.
fn dial_side_height() -> Len {
  0.85mm
}

-- expert_estimate: a pressed and printed date ring at this diameter.
fn date_indicator_thickness() -> Len {
  0.3mm
}

-- expert_estimate: the ring runs on the plate, under the maintaining plate.
fn date_indicator_seat_z() -> Len {
  dial_side_height() - date_indicator_thickness() - running_clearance()
}

-- expert_estimate: thin, and its top face is what the dial actually sits on.
fn maintaining_plate_thickness() -> Len {
  0.2mm
}

-- ------------------------------------------------------------ main plate
-- expert_estimate: thick enough to counterbore for the barrel and still leave
-- a floor for the barrel arbor's lower bearing, and to carry the keyless works
-- in a pocket in its dial-side face.
fn main_plate_thickness() -> Len {
  1.3mm
}

fn plate_dial_face_z() -> Len {
  dial_side_height()
}

fn plate_train_face_z() -> Len {
  plate_dial_face_z() + main_plate_thickness()
}

fn plate_mid_z() -> Len {
  plate_dial_face_z() + main_plate_thickness() / 2
}

-- The setting lever, yoke, jumper and corrector lie in a shallow pocket in the
-- dial-side face. The two PINIONS do not: they sit in the measured through-slot
-- (see `keyless_slot_*` above), which is why the stem axis is no longer derived
-- from this pocket's floor.
-- Deep enough that the yoke lies wholly inside it and still reaches the
-- sliding pinion's groove. The barrel bounds it in plan, not in depth.
fn keyless_pocket_depth() -> Len {
  0.7mm
}

fn keyless_pocket_floor_z() -> Len {
  plate_dial_face_z() + keyless_pocket_depth()
}

-- OPEN, and deliberately left as it was. The watchmaker's account gives the
-- winding pinion 12 teeth, and since it meshes the crown wheel it must share
-- the crown's 0.2298 module -- pitch radius 1.379, outside diameter 3.22.
-- That contradicts the 1.55 measured over its teeth on page 6 by more than a
-- factor of two, so one of the two is describing a different feature: most
-- likely the drawing measured the pinion's clutch end rather than its winding
-- toothing.
--
-- The stem's whole height hangs off this number (`stem_axis_z` below), so it
-- is NOT being changed on an unresolved conflict. The 11 teeth on 0.1149 below
-- reproduce the measured 1.55 and keep the keyless works where the audit left
-- them. Resolve the conflict, then move the stem once.
fn winding_pinion_pitch_radius() -> Len {
  ratchet_module() * 11 / 2
}

fn winding_pinion_tip_radius() -> Len {
  winding_pinion_pitch_radius() + ratchet_module()
}

-- DERIVED FROM THE MESH, not from the plate. The winding pinion straddles the
-- plate in the keyless slot and stands proud of the train side, where the
-- crown wheel's underside teeth meet it at 90 degrees. A face-gear mesh runs
-- with the pinion's pitch cylinder tangent to the crown wheel's pitch plane,
-- so the crown wheel's axial position sets the stem height and everything
-- downstream -- the crown, the case tube, the plate slot -- reads this number.
--
-- This replaces the earlier derivation from a blind pocket floor, which put
-- the stem 0.6mm too low and left the winding pinion unable to reach the crown
-- wheel at all. See ERRORS.md E1.
fn stem_axis_z() -> Len {
  crown_wheel_pitch_plane_z() - winding_pinion_pitch_radius()
}

-- expert_estimate: the barrel is taller than the space above the plate, so the
-- plate is counterbored for it. The remaining floor carries the lower pivot.
fn barrel_recess_depth() -> Len {
  1mm
}

fn barrel_recess_floor_z() -> Len {
  plate_train_face_z() - barrel_recess_depth()
}

-- ------------------------------------------- measured plate layout
-- Every bearing centre in this block is MEASURED, not solved. Position 1 Var
-- on page 6 of the ETA technical communication is an orthographic view of the
-- main plate from the train side, drawn at the published 25.60mm movement
-- diameter with the jewels coloured, so the centres can be read straight off
-- it. `tools/measure_plate_layout.py` reproduces the measurement, and
-- `eta_2824-2_info.md` records the orientation check and the agreement with
-- the tooth counts the beat rate independently requires.
--
-- Evidence class: drawing_scaled, good to about +/-0.1mm because the embedded
-- scan is 150 ppi. Better than a photo estimate, weaker than a dimensioned
-- drawing, and never a manufacturing dimension. Superseded the numerically
-- solved layout on 2026-09-05.
--
-- The keyless slot's measured centre lands on y = 0.012mm, which is an
-- independent confirmation that the stem axis is the +X axis.
--
-- ORIENTATION WARNING, see ERRORS.md E15. The plan below is HANDED CORRECTLY -
-- read from +z it has the same chirality as a back-of-movement photograph, by
-- the signed-area test on the barrel, crown wheel and balance. But it is TURNED
-- 180 DEGREES: +Y here points at the watch's 6 o'clock, not its 12, so the stem
-- on +X reads at 9 o'clock from the dial side where ETA drawing Z0091446 puts it
-- at 3. Every x and y below therefore needs negating before this is published.
-- Nothing needs mirroring, and nothing here is wrong in z.
fn barrel_centre_x() -> Len {
  2.834mm
}

fn barrel_centre_y() -> Len {
  5.705mm
}

fn second_wheel_x() -> Len {
  0mm - 4.075mm
}

fn second_wheel_y() -> Len {
  5.957mm
}

fn third_wheel_x() -> Len {
  0mm - 2.738mm
}

fn third_wheel_y() -> Len {
  2.473mm
}

-- The fourth wheel carries the sweep seconds and is on the movement axis.
fn fourth_wheel_x() -> Len {
  0mm
}

fn fourth_wheel_y() -> Len {
  0mm
}

fn escape_wheel_x() -> Len {
  0mm - 2.979mm
}

fn escape_wheel_y() -> Len {
  0mm - 2.02mm
}

fn pallet_fork_x() -> Len {
  0mm - 1.303mm
}

fn pallet_fork_y() -> Len {
  0mm - 4.219mm
}

fn balance_staff_x() -> Len {
  0mm - 2.388mm
}

fn balance_staff_y() -> Len {
  0mm - 6.567mm
}

-- A sixth jewel is present in the plate at this centre. It is 3.79 from the
-- third wheel and 5.56 from the second, which is the right order for a
-- minute-train pivot in an indirect-seconds movement, but no available source
-- names it. Recorded because it is there, not because it is understood; it is
-- not part of the going train and nothing is placed on it yet.
fn unidentified_plate_jewel_x() -> Len {
  0mm - 6.135mm
}

fn unidentified_plate_jewel_y() -> Len {
  0.803mm
}

-- ---------------------------------------------- keyless slot in the plate
-- Measured from the same view: a THROUGH-slot, not a blind pocket. This is the
-- direct evidence for the winding-pinion architecture -- the winding pinion
-- straddles the plate in this slot and stands proud on the train side, where
-- the crown wheel's underside teeth meet it at 90 degrees.
fn keyless_slot_centre_x() -> Len {
  8.963mm
}

fn keyless_slot_length() -> Len {
  4.79mm
}

fn keyless_slot_half_width() -> Len {
  1.33mm
}

fn keyless_slot_inner_x() -> Len {
  keyless_slot_centre_x() - keyless_slot_length() / 2
}

fn keyless_slot_outer_x() -> Len {
  keyless_slot_centre_x() + keyless_slot_length() / 2
}

-- ------------------------------------------------- going train and barrel
-- The train needs FOUR mesh planes, not two.
--
-- Consecutive wheels in a train always overlap in plan -- that is what a mesh
-- is -- so a wheel's disc and the pinion it drives share a plane and everything
-- else has to be somewhere else. On the measured layout the overlaps go
-- further than that: each wheel's rim also passes over the PREVIOUS wheel's
-- pinion, because the wheels are large relative to their centre distances.
-- Writing out every plan overlap that is not a mesh gives a graph whose
-- barrel/second/third/fourth mesh groups form a clique of four, so four
-- distinct planes are the minimum. The escape wheel's disc conflicts only with
-- the third and fourth discs, so it returns to plane 1 beside the barrel,
-- which is also where it belongs physically -- low, against the pallet fork.
--
--   plane 1  barrel great wheel + second pinion + escape wheel
--   plane 2  second wheel + third pinion
--   plane 3  third wheel + fourth pinion
--   plane 4  fourth wheel + escape pinion
--
-- Pinions are tall and may span two planes; it is the DISC thickness that sets
-- the spacing. Four planes at 0.19 with 0.15 discs leaves 0.04 between
-- neighbours and still lands the bridge under the 3.35mm base movement.
-- Thinned from 0.15 so the four planes fit BELOW the ratchet wheel. The
-- ratchet's underside is at 2.82 and it overlaps the fourth wheel by 0.87mm in
-- plan without meshing it, so the train has to clear it: four planes at 0.145
-- with 0.11 discs put the band ceiling at 2.79, and every one of the ratchet's
-- own numbers is measured while the 3.35 base movement height is not.
fn train_wheel_thickness() -> Len {
  0.11mm
}

fn train_plane_pitch() -> Len {
  0.145mm
}

fn train_band_floor_z() -> Len {
  plate_train_face_z() + endshake()
}

fn train_level_1_z() -> Len {
  train_band_floor_z() + 0.12mm
}

-- The barrel's great wheel is the one train member NOT on a train plane. Plane
-- 1 is at 2.30 and the crown wheel's underside teeth reach down past it, and
-- both of those are forced -- the crown wheel by its mesh with the ratchet,
-- plane 1 by the rest of the train -- so the great wheel is what moves.
--
-- It moves DOWN but not below the plate's train face. Dropping it into the
-- recess is the obvious move and it is wrong: the great wheel's tip radius is
-- larger than the recess, so its teeth would run through the plate's top
-- surface. It sits just clear of that face instead, and the crown wheel's
-- bevel is shortened to meet it.
fn barrel_wheel_z() -> Len {
  plate_train_face_z() + 0.08mm
}

-- Balance sweep, shared: the automatic framework has to be relieved around it,
-- and the framework cannot import the balance.
fn balance_sweep_radius() -> Len {
  5.25mm
}

fn train_level_2_z() -> Len {
  train_level_1_z() + train_plane_pitch()
}

fn train_level_3_z() -> Len {
  train_level_2_z() + train_plane_pitch()
}

fn train_level_4_z() -> Len {
  train_level_3_z() + train_plane_pitch()
}

fn train_band_ceiling_z() -> Len {
  train_level_4_z() + train_wheel_thickness() / 2
}

-- expert_estimate: a bridge this thin still needs a jewel seat, so its
-- thickness is set by the jewel, not by stiffness.
fn train_bridge_thickness() -> Len {
  0.34mm
}

fn train_bridge_underside_z() -> Len {
  train_band_ceiling_z() + endshake() + 0.01mm
}

fn train_bridge_top_z() -> Len {
  train_bridge_underside_z() + train_bridge_thickness()
}

-- expert_estimate: drum floor, mainspring height and lid for a 38-hour
-- reserve at this diameter.
fn barrel_height() -> Len {
  1.25mm
}

fn barrel_floor_z() -> Len {
  barrel_recess_floor_z() + endshake()
}

fn barrel_ceiling_z() -> Len {
  barrel_floor_z() + barrel_height()
}

fn barrel_bridge_thickness() -> Len {
  0.4mm
}

fn barrel_bridge_underside_z() -> Len {
  barrel_ceiling_z() + 0.17mm
}

fn barrel_bridge_top_z() -> Len {
  barrel_bridge_underside_z() + barrel_bridge_thickness()
}

-- ------------------------------------------------------- winding on top
-- The winding train's fine module. See the block below `keyless_pocket_depth`.
--
-- THE WINDING TRAIN CARRIES TWO MODULES, AND THAT IS THE WHOLE STORY.
--
-- The crown wheel's teeth are twice the pitch of the ratchet wheel's and
-- engage EVERY OTHER ONE. A watchmaker states it directly: winding pinion 12
-- teeth, crown wheel 26 "which only engage every other tooth on the ratchet
-- wheel", ratchet wheel 63. It is self-confirming -- the same account gives
-- 2.625 crown turns per ratchet turn, and 12/26 x 26/31.5 inverts to 2.6250
-- exactly from those three counts.
--
-- This model spent two days concluding a member was missing, because two
-- wheels of different pitch cannot mesh -- true of involute gearing, false of
-- a wolf-tooth winding drive. Every measurement taken was right. See ERRORS.md
-- E9.
--
-- The ratchet wheel's one fine toothing does three jobs: the click holds it,
-- the automatic module's driving pinion meshes it normally on 0.1149, and the
-- crown wheel engages it two teeth at a time on 0.2298. THIS IS WHY THE OLD
-- PINION ARGUMENT WAS RIGHT AND STILL IS: the automatic train's 8- and 10-leaf
-- pinions are cut on the fine module, and they would be 3 and 4 leaves on the
-- coarse one. Both modules are real; they belong to different meshes.
--
-- 63 is ODD, so the crown wheel does not re-engage the same teeth each turn --
-- 52 ratchet teeth per crown revolution against 63 on the wheel. The
-- engagement walks, which spreads the wear.
fn ratchet_module() -> Len {
  0.1149mm
}

fn winding_module() -> Len {
  ratchet_module() * 2
}

-- 26 teeth. photo_measured off IMG_9577.JPG, fit score 0.209 with harmonics at
-- 53 and 78 confirming the fundamental.
fn crown_wheel_pitch_radius() -> Len {
  2.9874mm
}

-- A crown tooth has to enter a ratchet SPACE, and a standard tooth on the
-- coarse module is twice too thick for one. So the teeth are slender, which is
-- what a wolf tooth is. Thinned to clear the ratchet's 0.1805 space width they
-- come to a POINT at 3.1775 -- an outside diameter of 6.355 against the
-- 6.29-6.41 measured off page 6. Nothing was fitted to that; it falls out of
-- the tooth thickness the mesh demands.
fn crown_wheel_tip_radius() -> Len {
  3.1775mm
}

-- 63 teeth. photo_measured off a teardown frame and confirmed by the ratio.
fn ratchet_wheel_pitch_radius() -> Len {
  3.61935mm
}

fn ratchet_wheel_tip_radius() -> Len {
  ratchet_wheel_pitch_radius() + ratchet_module()
}

-- Derived: the crown wheel's pitch circle is tangent to the stem axis, and its
-- centre lies at the mesh centre distance 6.6068 from the barrel axis. Solving
-- both puts it here, and the winding-pinion mesh point lands at X = +8.856 --
-- 0.107 from the centre of the keyless slot ETA actually cut, which was
-- measured independently and which nothing in the solve was told about.
fn crown_wheel_centre_x() -> Len {
  8.8561mm
}

fn crown_wheel_centre_y() -> Len {
  2.9874mm
}

-- Measured 7.40-7.54 over the tips and 0.53 thick; 63 teeth on module 0.1149.
fn ratchet_wheel_thickness() -> Len {
  0.53mm
}

fn ratchet_wheel_top_z() -> Len {
  base_movement_height()
}

fn ratchet_wheel_seat_z() -> Len {
  ratchet_wheel_top_z() - ratchet_wheel_thickness()
}

-- Measured: 0.82mm thick, and it is one disc rather than a rim under a boss.
-- A single 0.82 disc is what makes the two meshes possible at once: its upper
-- part is coplanar with the ratchet wheel it drives, and its underside reaches
-- far enough down to meet the winding pinion inside the plate. The barrel
-- bridge is relieved around it, which is why the assembled views show the
-- crown wheel standing in an opening rather than sitting on the bridge.
fn crown_wheel_thickness() -> Len {
  0.82mm
}

fn crown_wheel_top_z() -> Len {
  base_movement_height()
}

fn crown_wheel_seat_z() -> Len {
  crown_wheel_top_z() - crown_wheel_thickness()
}

-- The 90-degree interface to the stem. The crown wheel's underside carries a
-- band of teeth standing down from the disc; the winding pinion runs with its
-- pitch cylinder tangent to their pitch plane, one addendum below the face.
-- Shortened to 0.16 so the band clears the barrel's great wheel, which sits
-- just above the plate's train face. A face tooth does not need full depth.
fn crown_wheel_bevel_depth() -> Len {
  0.16mm
}

fn crown_wheel_bevel_floor_z() -> Len {
  crown_wheel_seat_z() - crown_wheel_bevel_depth()
}

fn crown_wheel_pitch_plane_z() -> Len {
  crown_wheel_seat_z() - winding_module()
}

-- ---------------------------------------------------------- automatic
-- The plane the automatic module bolts to, and its ceiling.
fn automatic_seat_z() -> Len {
  base_movement_height()
}

fn automatic_top_z() -> Len {
  movement_height()
}

-- expert_estimate: the reversing and reduction wheels run inside openings in
-- the framework rather than on top of it, which is how the module fits in
-- 1.25mm at all.
-- NOT A FLAT SLAB. The framework is the module's thick structural member and the
-- wheels sit down INSIDE it, in pockets sunk from its underside -- which is what
-- page 6's concentric steps around the rotor seat are. At 0.18 it was a sheet
-- lying over the wheels with nothing recessed. It now runs from just clear of
-- the lower bridge at 3.49 up to 4.05 under the weight's hub: 0.56 thick, with a
-- pocket over each wheel deep enough to swallow it.
fn automatic_framework_thickness() -> Len {
  0.56mm
}

-- WHICH SIDE OF THE WHEELS THE PLATE IS ON. Corrected 2026-09-06: the framework
-- is the OUTER member of the module. It lies against the oscillating weight and
-- the wheels hang BENEATH it, running in the openings cut through it; the lower
-- bridge -- which is what its name says it is -- is the INNER member, against
-- the movement. The model had the two the other way round, so from the back you
-- saw the wheels sitting on top of an exposed plate, which is the view you get
-- with the module turned over. Page 16's own mounted view shows the plate's face
-- with only the wheel teeth showing through it. See ERRORS.md E17.
--
-- The framework's ceiling is therefore the weight's hub, not the seat plane.
fn automatic_framework_top_z() -> Len {
  rotor_top_z() - rotor_hub_thickness() - running_clearance()
}

fn automatic_framework_seat_z() -> Len {
  automatic_framework_top_z() - automatic_framework_thickness()
}

fn automatic_bridge_thickness() -> Len {
  0.14mm
}

-- The lower bridge sits ON the automatic seat, under the wheels -- it is the
-- part of the module that touches the movement. It was at seat + 0.76, above
-- everything, which is the inverted stack E17 records.
fn automatic_bridge_underside_z() -> Len {
  automatic_seat_z()
}

fn automatic_bridge_top_z() -> Len {
  automatic_bridge_underside_z() + automatic_bridge_thickness()
}

-- expert_estimate: the weight's rim carries the mass and is the thickest part
-- of the rotor; its top face is the top of the movement.
-- The weight's rim hangs below its plate. Everything in the automatic
-- module runs inside the bore of this rim, which is what the module's
-- radial extent is solved against.
fn rotor_rim_thickness() -> Len {
  0.6mm
}

fn rotor_top_z() -> Len {
  automatic_top_z()
}

fn rotor_rim_floor_z() -> Len {
  rotor_top_z() - rotor_rim_thickness()
}

-- Derived: the bearing is the only part of the rotor that reaches down past the
-- bridge, and its floor has to clear the reduction wheel's ring, which passes
-- under it in plan.
fn rotor_bearing_height() -> Len {
  0.90mm
}

-- The bearing is flush with the weight's top face, and being taller than the
-- 0.5 hub it stands proud BELOW the hub, which is where its toothed ring goes.
fn rotor_bearing_top_z() -> Len {
  rotor_top_z()
}

fn rotor_bearing_floor_z() -> Len {
  rotor_bearing_top_z() - rotor_bearing_height()
}

-- MEASURED, page 6, blob 126 at 30.938 px/mm, anchored on the BEARING BORE --
-- which a least-squares fit of the outer arc puts within 0.10 of the arc's own
-- centre, so the bore is the rotor axis and the arc is concentric with it.
--
-- The fit gives R = 12.343 with a 0.05 residual. The raw ink is 24.953 across,
-- which wants 12.477, and 16.420 tall, which with the 4.043 hub wants 12.377.
-- The three disagree by 0.13 because the drawn part is very slightly squared off
-- at each end of the chord rather than running tangent into the arc. 12.38 is
-- the value that fits both extents; the end squares are not modelled.
fn rotor_radius() -> Len {
  12.38mm
}

-- ---------------------------------------------- the weight's own outline
-- All MEASURED off the same drawing. The oscillating weight is a SEGMENT OF A
-- DISC: one chord, a round hub boss standing above it, and a scallop each side
-- where the boss meets the chord. Inside it, two concentric steps.
--
-- THE 8.6mm BORE THIS PART USED TO HAVE IS NOT THERE. The weight is solid from
-- the hub outward and the arcs that suggested a bore are thickness steps. The
-- automatic module is not confined inside an 8.6 bore; it runs UNDER the web.
-- That was the guessed number E14 was blocked on.

-- How far BELOW the rotor axis the chord runs. The weight is very slightly
-- more than a half disc.
fn rotor_chord_drop() -> Len {
  0.083mm
}

-- Measured directly: the boss tops out 4.043 above the arc centre. The check is
-- that a 4.043 circle on the axis meets the chord at 4.042, and the scallop
-- beside it starts at a measured 4.02 -- so the notch begins exactly where the
-- boss lands on the chord, which is what the drawing shows.
fn rotor_hub_radius() -> Len {
  4.043mm
}

-- The two concentric steps, read down the symmetry axis.
fn rotor_hub_platform_radius() -> Len {
  7.198mm
}

fn rotor_web_radius() -> Len {
  9.589mm
}

-- The scallop each side. Column by column the notch runs 4.02 to 6.13 out and
-- bottoms 0.916 below the chord: half-width 1.05 with a 0.916 depth is not a
-- circle centred ON the chord, it is a 1.060 circle whose centre sits 0.144
-- ABOVE it -- 0.061 above the rotor axis. Both sides agree to 0.01.
fn rotor_scallop_radius() -> Len {
  1.06mm
}

fn rotor_scallop_x() -> Len {
  5.075mm
}

-- How far ABOVE the rotor axis the scallop's centre sits.
fn rotor_scallop_y() -> Len {
  0.061mm
}

-- MEASURED: the bore reads 4.654 across, so 2.327 to the inside of its own
-- outline stroke and about 2.39 to the metal. 31-3's ring is bored on the same
-- race and now takes this number instead of its own 2.45; at 2.82 over the
-- teeth the ring still cannot pass through, which is why it stays below the hub.
fn rotor_bearing_seat_radius() -> Len {
  2.39mm
}

-- The bearing's BORE, and it is a bore rather than a thread now.
--
-- MEASURED 2026-09-07: step 1 of `tools/framework_steps.py`, the innermost of
-- the eight concentric circles the project lead drew round position 25 on the
-- assembled movement. r/r_outer = 0.1495 against the plate's own 8.366.
--
-- It settles an architecture the model had backwards. 906 was threading into
-- the BEARING and the framework carried a 2.44 hole for the bearing to pass
-- through -- which left no annulus anywhere near the centre for the spacer the
-- same photographs plainly show, because 2.44 already ate it. The bearing's
-- inner race goes over a POST of position 25, the post is what 906 threads
-- into, and the two circles at the middle of the outline are that post and the
-- counterbore it stands in.
fn rotor_bearing_bore_radius() -> Len {
  1.25mm
}

-- 906 Var SCREWS INTO 31-2, so the bearing's central bore is the screw's thread,
-- not a clearance hole. This is `shank_r` on `eta_pos_906_rotor_screw_envelope`.
fn rotor_screw_thread_radius() -> Len {
  0.28mm
}

-- The screw's head and collar sit DOWN IN the bearing, on its inner race, not on
-- top of it -- the head is flush with the weight. The bearing therefore needs a
-- counterbore for them. `head_r` 0.72 and `collar_r` 0.44 over 0.34 of height,
-- on `eta_pos_906_rotor_screw_envelope`; the audit found 0.300 mm^3 of screw
-- inside solid bearing without this.
fn rotor_screw_head_radius() -> Len {
  0.72mm
}

fn rotor_screw_head_depth() -> Len {
  0.34mm
}

-- Over the teeth of 31-3, the ring the bearing carries. The framework's central
-- opening has to clear it: the ring turns with the weight and the framework does
-- not. It was a 2.4 bore against a 2.82 ring, which the audit found as
-- 0.367 mm^3 -- the largest single overlap in the model.
fn rotor_pinion_tip_radius() -> Len {
  2.82mm
}

-- expert_estimate: page 6 draws no elevation for this part, so the plan above
-- is measured and the three thicknesses are reasoned. The hub has to swallow
-- the bearing, the rim carries the mass at the published `rotor_rim_thickness`,
-- and the web between them is the thinnest section the module can run under.
fn rotor_hub_thickness() -> Len {
  0.5mm
}

fn rotor_web_thickness() -> Len {
  0.3mm
}

-- ------------------------------------------------ shared feature sizes
-- Sizes that more than one subsystem has to agree on. A feature owned by a
-- single subsystem stays in that subsystem's file.
-- expert_estimate: ETA states the stem thread as S 0.90; the body is turned
-- below the thread, and this is the running diameter in the plate.
fn stem_radius() -> Len {
  0.28mm
}

fn stem_hole_radius() -> Len {
  stem_radius() + running_clearance()
}

-- Measured: position 14 Var is 12.29mm over the great wheel's tooth tips, so
-- the tip radius is 6.145mm. The great wheel is 74 teeth meshing the second
-- wheel's 12-leaf pinion at the measured 6.914mm centre distance, which puts
-- the module at 0.1611 and the root radius at 5.76mm.
fn barrel_tip_radius() -> Len {
  6.145mm
}

-- The DRUM is turned smaller than the tooth root, because the second wheel's
-- pinion has to reach the great wheel's teeth and would otherwise foul the
-- drum below them.
fn barrel_radius() -> Len {
  5.7mm
}

-- The counterbore clears the DRUM, not the tooth tips: at this diameter a
-- recess taking the tips would break into the centre bore, and on the real
-- plate the teeth run over the surface in a shallower relief. The barrel
-- centre is 6.370 from the movement axis, so this recess stops 0.62 short of
-- it -- the constraint that now sets `centre_bore_radius`.
fn barrel_recess_radius() -> Len {
  barrel_radius() + running_clearance()
}

-- The centre-seconds arbor, the cannon pinion and the hour wheel tube all pass
-- through the plate on the centre axis. Derived, not chosen: the measured
-- barrel centre and drum radius leave 0.62mm of plate between the barrel
-- recess and the movement axis, so the through-bore cannot exceed that less a
-- wall. The hour wheel's larger tube needs a counterbore from the dial face,
-- which is a dial-side feature and is not this dimension.
fn centre_bore_radius() -> Len {
  0.55mm
}

-- ------------------------------------------------- dial-side sub-levels
-- Read from the dial seat upward, toward the plate.
-- expert_estimate: the dial support ring is what the dial actually rests on,
-- so its dial-side face is the datum plane itself.
fn dial_support_thickness() -> Len {
  0.2mm
}

fn dial_support_top_z() -> Len {
  dial_seat_z() + dial_support_thickness()
}

-- expert_estimate: the dial-side bridge sits between the dial and the wheels
-- it carries, so it is the first thing above the dial support.
fn minute_bridge_underside_z() -> Len {
  dial_support_top_z() - 0.1mm
}

fn minute_bridge_thickness() -> Len {
  0.3mm
}

fn minute_bridge_top_z() -> Len {
  minute_bridge_underside_z() + minute_bridge_thickness()
}

-- expert_estimate: the calendar and motion wheels share one band between the
-- dial-side bridge and the plate.
fn calendar_band_floor_z() -> Len {
  minute_bridge_top_z() + endshake()
}

fn calendar_band_ceiling_z() -> Len {
  plate_dial_face_z() - endshake()
}

-- expert_estimate: the date ring runs against the plate's dial face, at the
-- outside of the calendar band, and the maintaining plate holds it there.
fn date_indicator_top_z() -> Len {
  calendar_band_ceiling_z() - running_clearance()
}

fn date_indicator_floor_z() -> Len {
  date_indicator_top_z() - date_indicator_thickness()
}

fn maintaining_plate_top_z() -> Len {
  date_indicator_floor_z() - running_clearance()
}

fn maintaining_plate_floor_z() -> Len {
  maintaining_plate_top_z() - maintaining_plate_thickness()
}

-- ------------------------------------------------------- screw axes
-- Every screw axis in the movement, in one place. A bridge's foot, its
-- clearance hole, the tapped hole in the plate and the screw itself all read
-- the same pair of numbers, so they cannot drift apart.
--
-- The positions were re-solved on 2026-09-05 against the measured layout: each
-- clears every wheel's tip circle, the barrel, the balance rim, the crown wheel
-- and the keyless slot by at least 0.15mm beyond its own head, and sits inside
-- the 25.60mm casing seat. The two bridges' feet also bracket the pivots they
-- carry rather than hanging off one end.
fn train_bridge_screw_a_x() -> Len {
  0mm - 7.8mm
}

fn train_bridge_screw_a_y() -> Len {
  2.22mm
}

fn train_bridge_screw_b_x() -> Len {
  3.9mm
}

fn train_bridge_screw_b_y() -> Len {
  0mm - 3.42mm
}

fn barrel_bridge_screw_a_x() -> Len {
  4.14mm
}

fn barrel_bridge_screw_a_y() -> Len {
  0mm - 1.2mm
}

fn barrel_bridge_screw_b_x() -> Len {
  9.66mm
}

fn barrel_bridge_screw_b_y() -> Len {
  7.02mm
}

fn balance_cock_screw_x() -> Len {
  1.26mm
}

fn balance_cock_screw_y() -> Len {
  0mm - 11.88mm
}

fn pallet_bridge_screw_x() -> Len {
  0.42mm
}

fn pallet_bridge_screw_y() -> Len {
  0mm - 7.14mm
}

-- MEASURED off a bench photograph of position 25 face up, carried through the
-- registration that fixed the plate's pose (see `automatic_winding.cade`). Screw
-- a was 5.49 out on radius alone, which E16 had already flagged; both are now
-- read off the part rather than estimated from oblique frames.
fn automatic_framework_screw_a_x() -> Len {
  6.8964mm
}

fn automatic_framework_screw_a_y() -> Len {
  2.6539mm
}

fn automatic_framework_screw_b_x() -> Len {
  5.3514mm
}

fn automatic_framework_screw_b_y() -> Len {
  0mm - 5.3459mm
}

fn automatic_bridge_screw_x() -> Len {
  1.5mm
}

fn automatic_bridge_screw_y() -> Len {
  7.85mm
}

-- A bridge stands on feet turned from the same blank, not on air.
fn bridge_foot_radius() -> Len {
  0.5mm
}

-- ------------------------------------------------------- allowances
-- Nominal size and allowance are separate parameters, per CLAUDE.md Phase 4.
-- These are provisional values from the engineering guides, not ETA limits.
-- expert_estimate: axial freedom of a wheel between its two bearings.
fn endshake() -> Len {
  0.03mm
}

-- expert_estimate: side clearance between two bodies that move relative to
-- each other and do not transmit load.
fn running_clearance() -> Len {
  0.05mm
}

-- expert_estimate: a fixed body against a fixed body.
fn static_clearance() -> Len {
  0.1mm
}

-- expert_estimate: diametral running fit of a pivot in its jewel hole.
fn pivot_running_fit() -> Len {
  0.02mm
}

-- A jewel is a press fit in its seat. The model draws the seat at its nominal
-- bore plus this clearance rather than at the interference, so the assembly has
-- no accidental solid overlap; the press allowance is a manufacturing note in
-- eta_2824-2_info.md, not geometry.
fn jewel_seat_clearance() -> Len {
  0.02mm
}

-- expert_estimate: clearance hole around a screw shank through a bridge.
fn screw_clearance() -> Len {
  0.04mm
}

-- expert_estimate: radial gap left at a gear mesh so tooth flanks are not
-- forced. Applied to the sum of the tip radii, not buried in a centre distance.
fn gear_backlash() -> Len {
  0.02mm
}

-- ------------------------------------------------------- diagnostics
-- The movement must fit between the dial seat and the published overall
-- height. This part is the slab that is legal; `movement_stack_diagnostic`
-- below must have the same volume as the movement's own bounding cylinder
-- intersected with it, which is to say: nothing may stick out of it.
part legal_movement_envelope() -> Solid<Exact> {
  cylinder(r = movement_radius(), h = movement_height())
    |> at(dx = 0mm, dy = 0mm, dz = movement_height() / 2)
}

-- A visible picture of the budget. Each band is its own part so it can carry
-- its own colour, and the stack is drawn at half radius so the movement can be
-- viewed through it.
fn band_radius() -> Len {
  6mm
}

part band_dial_side() -> Solid<Exact> {
  cylinder(r = band_radius(), h = dial_side_height())
}

part band_main_plate() -> Solid<Exact> {
  cylinder(r = band_radius(), h = main_plate_thickness())
}

part band_train() -> Solid<Exact> {
  cylinder(r = band_radius(), h = train_bridge_top_z() - plate_train_face_z())
}

part band_winding() -> Solid<Exact> {
  cylinder(r = band_radius(), h = base_movement_height() - train_bridge_top_z())
}

part band_automatic() -> Solid<Exact> {
  cylinder(r = band_radius(), h = automatic_module_height())
}

part datum_stack_preview() -> Assembly {
  together(
    band_dial_side()
      |> place(
        frame = frame(
          origin = point(x = 0mm, y = 0mm, z = dial_side_height() / 2),
          axis = Z,
          angle = 0deg,
        ),
        color = rgba(r = 208, g = 196, b = 168, a = 120),
      ),
    band_main_plate()
      |> place(
        frame = frame(
          origin = point(x = 0mm, y = 0mm, z = plate_mid_z()),
          axis = Z,
          angle = 0deg,
        ),
        color = rgba(r = 176, g = 172, b = 160, a = 120),
      ),
    band_train()
      |> place(
        frame = frame(
          origin = point(
            x = 0mm,
            y = 0mm,
            z = (plate_train_face_z() + train_bridge_top_z()) / 2,
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgba(r = 214, g = 176, b = 72, a = 120),
      ),
    band_winding()
      |> place(
        frame = frame(
          origin = point(
            x = 0mm,
            y = 0mm,
            z = (train_bridge_top_z() + base_movement_height()) / 2,
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgba(r = 150, g = 158, b = 168, a = 120),
      ),
    band_automatic()
      |> place(
        frame = frame(
          origin = point(
            x = 0mm,
            y = 0mm,
            z = (base_movement_height() + movement_height()) / 2,
          ),
          axis = Z,
          angle = 0deg,
        ),
        color = rgba(r = 120, g = 146, b = 178, a = 120),
      ),
  )
}
